# ============================================================================
# ImageBuilder 包清单 (每行一个包, # 开头为注释)
#
# 这些包名已对照 OpenWrt 25.12.5 x86/64 官方源逐一验证存在。
# 注意与旧 .config 的差异(旧名在 25.12 中已不存在, 从源码编时才会被静默忽略):
#   kmod-r8152            -> kmod-usb-net-rtl8152   (RTL8153 USB 网卡)
#   linux-firmware-mt7921e -> kmod-mt7921-firmware + kmod-mt7922-firmware
#     (MT7921 与 MT7922 的固件是**两个**包: 7922 的卡缺 kmod-mt7922-firmware
#      就会"驱动加载了但接口不出来", 真机踩到过)
#   linux-firmware-mediatek -> (由上面两个 kmod 固件包覆盖, 无需单独装)
#   traceroute            -> 上游已无此包, 已移除
#   luci-app-openclash / luci-app-oaf / appfilter / kmod-oaf
#                         -> 由 workflow 从第三方 release 拉取预编译包, 不在此列出
#   apk / apk-libs / luci-app-* 的基础依赖 -> 由 ImageBuilder 自动解析
# ============================================================================

# ---- 有线网卡: Realtek RTL8111/8168 (r8169) ----
kmod-r8169

# ---- USB 网卡: RTL8153 (r8152) + 常见 USB 网络协议 ----
kmod-usb-net-rtl8152
kmod-usb-net
kmod-usb-net-cdc-ether
kmod-usb-net-rndis
kmod-usb-net-aqc111
kmod-usb-serial
kmod-mii

# ---- USB 控制器与存储 ----
kmod-usb2
kmod-usb3
kmod-usb-storage
kmod-usb-storage-uas
kmod-usb-storage-extras
kmod-scsi-core

# ---- 内置盘: SATA(AHCI) 与 NVMe ----
kmod-ata-core
kmod-ata-ahci
kmod-nvme

# ---- 无线网卡: MediaTek MT7921/MT7922 (mt7921e 驱动) + 固件 ----
# 注意: MT7921 与 MT7922 的**固件是两个包**, 不能只装一个!
#   缺 kmod-mt7922-firmware 时, mt7921e 能加载但拿不到固件 ->
#   dmesg 报 "Direct firmware load for mediatek/WIFI_RAM_CODE_MT7922_1.bin failed",
#   接口不出现, 表现就是"7922 网卡驱动没起来"(真机踩到)。
kmod-mt7921e
kmod-mt7921-firmware
# MT7922 专用固件(7922 的卡必须装这个)
kmod-mt7922-firmware

# ---- 网络与调试工具 ----
curl
dnsmasq-full
htop
iperf3
tcpdump
ppp-mod-pppoe

# ---- 内置盘安装后扩容所需(基础固件内没有这两个) ----
resize2fs
sfdisk

# ---- 数据分区自动挂载 ----
# 提供 /etc/init.d/fstab 与 /etc/config/fstab。缺省镜像里没有这个包,
# README「想用剩余空间建数据分区」一节要靠它才能开机自动挂载,
# 否则 /etc/config/fstab 不存在、/etc/init.d/fstab 也不存在。
# (e2fsck / mkfs.ext4 由缺省已装的 e2fsprogs 提供, 无需额外加。)
block-mount

# ---- 交互式菜单(openwrt-install 的菜单界面需要 whiptail) ----
whiptail

# ---- LuCI 中文界面 + HTTPS ----
luci
luci-ssl
luci-i18n-base-zh-cn
luci-i18n-firewall-zh-cn

# ---- Argon 主题(iStoreOS 风格) 与 DDNS-GO 的 LuCI 页面所需 ----
# 注意: luci-theme-argon 和 ddns-go 官方源里都没有, 由 workflow 直接把文件
# 打进固件(见 "Stage Argon theme" / "Stage DDNS-GO" 两步), 所以不在这里列包名。
# 这里只列它们的运行时依赖:
jsonfilter
wget-ssl

# ---- Lua 版 LuCI 应用支持(自带的 DDNS-GO 页面是 Lua 写的) ----
# LuCI 25.x 把 Lua 运行时与兼容层单独分包, 缺了它们这个页面会 500。
luci-compat
luci-lua-runtime

# ---- 文件系统工具(安装器装完要跑的 e2fsck / resize2fs 靠它) ----
e2fsprogs

# ---- UEFI 启动顺序(--boot-order): 让主板从优盘而不是内置盘启动 ----
# 官方源里有 efibootmgr(依赖 efivar)。注意: 它只能在 UEFI 启动的系统里用。
efibootmgr

# ============================================================================
# Dell Wyse 3040 的无线网卡: Marvell 88W8897(AzureWave AW-CM389MA, SDIO 接口)
# ----------------------------------------------------------------------------
# 依据:
#   * OpenWrt 论坛专帖 "Dell Wyse 3040 with Marvell 88W8897 WiFi card"
#     https://forum.openwrt.org/t/dell-wyse-3040-with-marvell-88w8897-wifi-card/177119
#   * DietPi 论坛里同为 Wyse 3040 + AW-CM389MA 的实例(接口名 mlan0, 即 mwifiex)
# 这块卡是 SDIO 卡(不是 PCIe), 所以除了 WiFi 驱动还得有 MMC/SDIO 主机支持。
# 官方 x86/64 的 kmods 源里这几个包都有(已核对 25.12.5 / 6.12.94)。
# ============================================================================
# 注意: 包名后面**不能写行内注释**! 解析清单的脚本只按"整行注释"过滤,
# 行内注释会被当成包名的一部分, 构建时报 syntax error near unexpected token '('
# (本地实测踩到过)。注释一律写在自己一行上。

# mwifiex SDIO 驱动(SDIO, 88W8897; 接口名 mlan0)
kmod-mwifiex-sdio
# 驱动要的固件: mrvl/sd8897_uapsta.bin
mwifiex-sdio-firmware
# MMC/SDIO 核心(mwifiex-sdio 的依赖)
kmod-mmc
# Atom(Cherry Trail)上的 SD/SDIO 主机控制器
kmod-sdhci

# 无线诊断(加密认证所需的 wpad/hostapd 基础已随默认包进来, 不再重复列)
# iwinfo: 看信号强度/加密方式/关联状态
iwinfo
# iw dev / iw list: 看接口与设备能力
iw

# ============================================================================
# 无线认证/AP 守护进程(wpad) —— 必须显式安装
# ----------------------------------------------------------------------------
# x86/64 的默认包集里**不含** wpad, 镜像里只有 hostapd-common(它提供的只是
# /etc/init.d/wpad 与公共文件), 没有 /usr/sbin/wpad 这个可执行文件。
# 结果: 无线接口能认出来, 但 LuCI 配置 AP / 连接 / mesh 时会提示
# "需要安装 mesh 版 wpad", 而且实际也起不来。
# 这里直接上**完整版** wpad-mbedtls: 支持 802.11s mesh、802.11r/k/v 快速漫游、
# WPA2/WPA3 个人版与企业版 —— 一步到位, 不会再弹"请安装 xx 版 wpad"。
# (要更省空间可换成 wpad-mesh-mbedtls: 有 mesh, 但没有企业级/漫游那部分。)
# ============================================================================
wpad-mbedtls
