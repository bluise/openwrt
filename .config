CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_Generic=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_GRUB_EFI=y
CONFIG_TARGET_EFI_IMAGES=y
CONFIG_TARGET_PREINIT_IP="10.0.0.1"
CONFIG_TARGET_MULTI_PROFILE=y

# LuCI 及中文
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# 应用: OpenClash / OAF (来自 feeds)
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-oaf=y

# 无线网卡 MT7922 (mt7921e 驱动)
CONFIG_PACKAGE_kmod-mt7921e=y
CONFIG_PACKAGE_linux-firmware-mt7921e=y
CONFIG_PACKAGE_linux-firmware-mediatek=y

# ========== 启动关键驱动(必须内置到内核, 否则U盘引导卡 Booting) ==========
# USB 控制器: XHCI(3.0)/EHCI(2.0)/OHCI(1.1) 全部内置
CONFIG_KERNEL_USB=y
CONFIG_KERNEL_USB_XHCI_HCD=y
CONFIG_KERNEL_USB_XHCI_PCI=y
CONFIG_KERNEL_USB_EHCI_HCD=y
CONFIG_KERNEL_USB_EHCI_PCI=y
CONFIG_KERNEL_USB_OHCI_HCD=y
# USB 存储(挂 rootfs 必需)
CONFIG_KERNEL_USB_STORAGE=y
CONFIG_KERNEL_USB_UAS=y
# USB 网络(内置盘安装后使用)
CONFIG_KERNEL_USB_NET=y
CONFIG_KERNEL_USB_NET_RTL8152=y
# SATA(AHCI) 与 NVMe 内置盘支持
CONFIG_KERNEL_ATA=y
CONFIG_KERNEL_SATA_AHCI=y
CONFIG_KERNEL_NVME=y
# 根文件系统
CONFIG_KERNEL_EXT4_FS=y
CONFIG_KERNEL_SQUASHFS=y

# ========== USB 网卡 / 存储 / 无线 驱动包 ==========
# USB 有线网卡 RTL8153 (r8152 驱动)
CONFIG_PACKAGE_kmod-r8152=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-aqc111=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-mii=y
# USB 基座 + 存储(U盘/移动硬盘/UAS)
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-scsi-core=y
# 内置盘: SATA AHCI + NVMe
CONFIG_PACKAGE_kmod-ata-core=y
CONFIG_PACKAGE_kmod-ata-ahci=y
CONFIG_PACKAGE_kmod-nvme=y

# 网络常用组件
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_odhcpd-ipv6only=n
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_traceroute=y
CONFIG_PACKAGE_iperf3=y

# 包管理器: apk (OpenWrt 25.12 默认, 替代旧版 opkg)
CONFIG_PACKAGE_apk=y
CONFIG_PACKAGE_apk-libs=y
# opkg 已在 25.12 中移除, 不选
# CONFIG_PACKAGE_opkg is not set

# 编译优化/磁盘: 不用 ccache, 避免磁盘溢出
CONFIG_CCACHE=n