#!/bin/sh
# =============================================
# openwrt-install : 一键安装 OpenWrt 到内置硬盘
# 用法: openwrt-install [选项] [固件路径]
#   - 默认就是"克隆安装": 把当前运行的介质(U盘)整盘复制到内置盘, 不需要镜像文件/网络
#     (只有显式给路径时才写镜像文件: openwrt-install --fw /path/to/*.img.gz)
#   - 自动识别内置盘并**排除启动盘与U盘**, 判断全部读 sysfs
#     (不能用 lsblk: 固件里没有该命令, 详见下面的说明)
#   - 多块候选盘时列出让你选; 非交互环境不会瞎猜, 必须用 --disk 指定
#   - 界面默认中文; 终端显示不了中文时用 --en 切纯 ASCII 英文
#     (退出菜单: 0 / Esc / "退出"按钮; 纯文本菜单还可输 q)
#   - 写入后只读检测空间: rootfs 固定 2048 MiB 为设计目标, 剩余空间保持未分配
#     (只读探测, 不自动修改分区表; 需要扩容时会打印具体命令)
# =============================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info()  { echo -e "${GREEN}[INFO]${NC} $*"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_err()   { echo -e "${RED}[ERROR]${NC} $*"; }

# =============================================
# 界面语言 / 终端编码
# =============================================
# 为什么必须显式设 locale:
#   whiptail 基于 newt+slang, 而 musl 没有 locale 数据、固件也不设 LANG。
#   libslang 是靠 setlocale/nl_langinfo/LC_ALL/LC_CTYPE 判断"要不要进 UTF-8
#   模式"的 —— 判定失败时它按"一个字节=一个字符"处理, 每个汉字被当成两个
#   字符: 宽度算错 → 菜单边框画歪、条目错位串行(看着就是乱码), 底部"退出"
#   看不见也点不准(这就是"菜单乱码 + 退不出去"的根因)。
#   显式给一个 UTF-8 locale 后 slang 进入 UTF-8 模式, libnewt 用
#   mbrtowc/wcwidth 按双宽计算(它编译时带了 _newt_wstrlen), 中文与边框都正常。
#
# 但终端本身显示不了中文时(本机控制台没有中文字形, 或 SSH 客户端用 GBK),
# 宽度算得再对也没用。所以交互界面(菜单/对话框/提示)提供纯 ASCII 英文:
#   openwrt-install --en        强制英文界面
#   openwrt-install --zh        强制中文界面
#   OPENWRT_UI=en|zh            同样效果的环境变量
# 默认: TERM 为空/dumb/linux(通常就是本机控制台)时用英文, 其余用中文。
#   注意: 本机控制台(VGA/虚拟机控制台/串口)用的是内核 8x16 位图字体, 里头
#   根本没有汉字字形 —— 那种终端上中文是**画不出来**的, 跟固件无关。
#   想要中文就在支持 UTF-8 的终端里 SSH 上来跑(TERM=xterm-*), 会自动用中文。
# 报告正文(空间检测那一段)不翻译: 里面主要是路径/扇区/命令, 本身是 ASCII。
UI_FORCE=""
UI_EN=""
UI_AUTO_EN=""     # 1 = 是我们自动切成英文的(而非用户强制), 用于给出一句解释

ui_setup() {
  lang=${UI_FORCE:-${OPENWRT_UI:-auto}}
  UI_AUTO_EN=""
  case "$lang" in
    en|EN|English|english) UI_EN=1 ;;
    zh|ZH|Chinese|chinese) UI_EN="" ;;
    *)
      case "${TERM:-}" in
        ""|dumb|linux) UI_EN=1; UI_AUTO_EN=1 ;;
        *) UI_EN="" ;;
      esac ;;
  esac
  if [ "$UI_EN" = "1" ]; then
    return 0
  fi
  # musl 认 C.UTF-8; slang 看到 UTF-8 就开双宽处理
  LC_ALL=C.UTF-8
  LANG=C.UTF-8
  export LC_ALL LANG
  return 0
}

# 自动切英文时, 在菜单里带一句解释(TERM=linux 的终端画不出汉字)
ui_note() {
  if [ "$UI_EN" = "1" ] && [ "$UI_AUTO_EN" = "1" ]; then
    printf ' [English UI: TERM=%s cannot display CJK; SSH in for Chinese / --zh]' "${TERM:-empty}"
  fi
}

# 双语取值: zh_en '中文' 'English'
zh_en() {
  if [ "$UI_EN" = "1" ]; then
    printf '%s' "$2"
  else
    printf '%s' "$1"
  fi
}

# ---------- 1. 确定目标磁盘(排除启动盘与U盘) ----------
# 判断依据全部来自 sysfs, 不用 lsblk:
#   lsblk 是 util-linux 的独立包, 缺省固件里没有(packages.list 也没加),
#   busybox 更不提供该 applet。原先用 `lsblk -dno TRAN` 判断 USB, 在真机上
#   恒为空字符串 —— 后果是 U 盘从不被跳过。改成读 sysfs 路径后与工具包无关。

# 设备名 -> 整盘名: sda2->sda, nvme0n1p2->nvme0n1, mmcblk0p2->mmcblk0
disk_of_part() {
  n=$(basename "$1")
  if [ -r "/sys/class/block/$n/partition" ]; then
    # 分区: 解析 sysfs 路径的父目录名(即整盘名)
    real=$(readlink -f "/sys/class/block/$n" 2>/dev/null || true)
    b=$(basename "$(dirname "$real")" 2>/dev/null || true)
    # 校验 b 确实是一块整盘, 避免 readlink 异常时返回垃圾值
    if [ -n "$b" ] && [ -d "/sys/class/block/$b" ] && [ ! -e "/sys/class/block/$b/partition" ]; then
      echo "$b"; return
    fi
  elif [ -e "/sys/class/block/$n" ]; then
    echo "$n"; return
  fi
  # sysfs 不可用时的名字兜底
  case "$n" in
    nvme*|mmcblk*|md*|pmem*) case "$n" in *p[0-9]*) echo "${n%p[0-9]*}" ;; *) echo "$n" ;; esac ;;
    *[0-9]) echo "${n%[0-9]*}" ;;
    *) echo "$n" ;;
  esac
}

# 传输类型: USB 设备的 sysfs 路径里一定有一段 /usbN。
# 只认路径, 不看 removable —— USB 硬盘盒的 removable 常为 0,
# 而读卡器又常为 1, 都不能作为判据。
disk_transport() {
  d=$(basename "$1")
  case "$(readlink -f "/sys/class/block/$d" 2>/dev/null)" in
    */usb[0-9]*|*/usb/*) echo usb ;;
    *) echo "" ;;
  esac
}

# 列出所有"整盘"(排除分区/虚拟设备/光驱): sda sdb nvme0n1 vda ...
list_disks() {
  for p in /sys/class/block/*; do
    [ -e "$p" ] || continue
    d=$(basename "$p")
    if [ -e "$p/partition" ]; then continue; fi
    if [ ! -e "$p/device" ]; then continue; fi
    case "$d" in loop*|ram*|zram*|dm-*|md*|sr*|fd*|nbd*) continue ;; esac
    if [ ! -b "/dev/$d" ]; then continue; fi
    printf '%s\n' "$d"
  done
}

# 启动盘: OpenWrt 里 /rom 是真实根文件系统所在(overlay 的 / 不行),
# 读不到再退到内核命令行 root=
#
# 注意 /proc/mounts 的列序是: 设备 挂载点 类型 选项 ...
# 挂载点是**第 2 列**。原先写成 $3 比的是文件系统类型, 永远匹配不上,
# 只是宿主上恰好有 findmnt 兜住才没暴露 —— 而 OpenWrt 里没有 findmnt,
# 于是真机上"启动盘识别失败", 正在运行的系统盘会被当成可写候选盘(危险)。
find_boot_src() {
  BOOT_SRC=""
  for mp in /rom /; do
    s=$(awk -v m="$mp" '$2 == m {print $1; exit}' /proc/mounts 2>/dev/null || true)
    if [ -z "$s" ]; then
      s=$(awk -v m="$mp" '$5 == m {print $1; exit}' /proc/self/mountinfo 2>/dev/null || true)
    fi
    if [ -z "$s" ]; then
      s=$(findmnt -no SOURCE "$mp" 2>/dev/null || true)
    fi
    case "$s" in /dev/*) BOOT_SRC=$s; break ;; esac
  done
  if [ -z "$BOOT_SRC" ]; then
    r=$(sed -n 's/.*[[:space:]]root=\([^[:space:]]*\).*/\1/p' /proc/cmdline 2>/dev/null || true)
    case "$r" in /dev/*) BOOT_SRC=$r ;; esac
  fi
  [ -n "$BOOT_SRC" ] || return 1
  echo "$BOOT_SRC"
}

# 某块设备底下的物理整盘(顺着 slaves 递归, 处理 md/lvm 叠加):
#   /dev/mapper/vg-lv -> dm-0 -> md0 -> sda3 -> sda
boot_disks_of() {
  n=$(basename "$1")
  p="/sys/class/block/$n"
  if [ ! -e "$p" ]; then
    # 名字不在 sysfs(如 /dev/mapper/xxx), 先用 readlink 规范化成 dm-N
    real=$(readlink -f "$1" 2>/dev/null || true)
    n=$(basename "$real")
    p="/sys/class/block/$n"
  fi
  if [ -e "$p/slaves" ]; then
    found=0
    for s in "$p"/slaves/*; do
      [ -e "$s" ] || continue
      found=1
      boot_disks_of "/dev/$(basename "$s")"
    done
    [ "$found" = "1" ] && return 0
  fi
  disk_of_part "/dev/$n"
}

# 启动盘名字列表(空格分隔, 可能多块)
find_boot_disks() {
  SRC=$(find_boot_src 2>/dev/null || true)
  [ -n "$SRC" ] || return 1
  boot_disks_of "$SRC" | tr '\n' ' '
}

# $1 是否为启动盘名字
is_boot_disk() {
  for b in $BOOT_DISKS; do
    [ "$b" = "$1" ] && return 0
  done
  return 1
}

# 凡是"有分区正在被挂载"的整盘都算在用 —— 这是启动盘识别的兜底保护。
# 虚拟机里 /proc/cmdline 常用 root=PARTUUID=... , 万一启动盘识别不出来,
# 这条也能挡住"把正在运行的系统盘当目标盘"。
# (OpenWrt x86 上 /rom 与 /boot 都是真实分区, 所以运行盘一定在这里面。)
# 走 boot_disks_of 是为了把 dm/md 叠加(LVM/RAID)解析回物理整盘。
# 挂载点算不算"关键": 只有承载运行系统本身的分区才算。
# 数据分区一般挂在 /mnt/* 或 /media/*(老系统残留的分区会被启动系统自动挂载),
# 那种情况**不该**阻止安装 —— 写盘前把它们卸掉就行(见 unmount_target)。
mount_is_critical() {
  case "$1" in
    /mnt/*|/media/*) return 1 ;;
    *) return 0 ;;      # / /rom /boot /overlay ... 以及任何不认识的挂载点都算关键
  esac
}

# 有"关键分区"在挂载的整盘(会被保护, 不允许当目标盘)
critical_mounted_disks() {
  awk '$1 ~ /^\/dev\// {print $1, $2}' /proc/mounts 2>/dev/null \
  | while read -r dev mp; do
      if mount_is_critical "$mp"; then boot_disks_of "$dev"; fi
    done | sort -u | tr '\n' ' '
  :   # 保证函数返回 0(原因见 disk_mounts)
}

# 某块盘上正在挂载的分区(含挂载点), 形如 "/dev/sdb3@/mnt/sdb3 "; 供日志与卸载用
disk_mounts() {   # $1=整盘名(如 sda)
  awk '$1 ~ /^\/dev\// {print $1, $2}' /proc/mounts 2>/dev/null \
  | while read -r dev mp; do
      [ "$(disk_of_part "$dev")" = "$1" ] && printf '%s@%s ' "$dev" "$mp"
    done
  # 必须显式返回 0: 管道里最后一次 [ ] 测试失败会让函数返回 1, 而
  # "x=$(disk_mounts ...)" 在 set -e 下会因此直接结束整个脚本(实测踩到过)
  :
}

# 写盘前卸掉目标盘上已挂载的分区(整盘马上要被覆盖, 必须卸干净)
unmount_target() {
  t=$(basename "$TARGET")
  parts=$(disk_mounts "$t" || true)
  [ -n "$parts" ] || return 0
  log_warn "$(zh_en "目标盘 $TARGET 上有分区正在挂载, 先卸载: $parts" \
                    "Target disk $TARGET has mounted partitions, unmounting: $parts")"
  awk '$1 ~ /^\/dev\// {print $1, $2}' /proc/mounts 2>/dev/null \
  | while read -r dev mp; do
      if [ "$(disk_of_part "$dev")" = "$t" ]; then
        umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null || \
          log_err "$(zh_en "卸载 $mp 失败" "Failed to unmount $mp")"
      fi
    done
  parts2=$(disk_mounts "$t" || true)
  if [ -n "$parts2" ]; then
    log_err "$(zh_en "目标盘仍有分区在挂载: $parts2 —— 拒绝写入(先手动 umount, 或用 --force)" \
                      "Target still has mounted partitions: $parts2 - refusing to write (umount it, or use --force)")"
    return 1
  fi
  log_info "$(zh_en '目标盘已卸载干净, 继续' 'Target disk is now unmounted, continuing')"
  return 0
}

is_mounted_disk() {
  for b in $MOUNTED_DISKS; do
    [ "$b" = "$1" ] && return 0
  done
  return 1
}

# 人类可读的盘信息: 容量 + 型号 (供候选列表与倒计时显示)
disk_desc() {
  d=$(basename "$1")
  sz=$(cat "/sys/class/block/$d/size" 2>/dev/null || true)
  human="?"
  if [ -n "$sz" ] && [ "$sz" -gt 0 ] 2>/dev/null; then
    b=$((sz * 512))
    g10=$((b * 10 / 1073741824))
    if [ "$g10" -ge 10 ]; then
      human="$((g10 / 10)).$((g10 % 10)) GiB"
    else
      human="$((b / 1048576)) MiB"
    fi
  fi
  model=$(cat "/sys/class/block/$d/device/model" 2>/dev/null | tr -d '\n' | sed 's/[[:space:]]*$//' || true)
  t=$(disk_transport "$d")
  printf '%s%s%s' "$human" "${model:+  $model}" "${t:+  ($t)}"
}

# 候选列表 CAND(形如 " sdb sdc")的第一项
first_cand() {
  c=${CAND# }
  echo "${c%% *}"
}

# 确定目标盘。显式指定(--disk) > 唯一候选 > 交互选择; 绝不静默挑一块。
# 传入 --first 时表示只做只读探测(菜单 2/6), 多块候选就取第一块。
find_target_disk() {
  FIRST_ONLY=0
  [ "${1:-}" = "--first" ] && FIRST_ONLY=1

  TARGET=""
  BOOT_DISKS=$(find_boot_disks 2>/dev/null || true)
  MOUNTED_DISKS=$(critical_mounted_disks || true)
  if [ -n "$BOOT_DISKS" ]; then
    for b in $BOOT_DISKS; do
      log_info "$(zh_en "启动盘: /dev/$b  ($(disk_desc "$b"))" "Boot disk: /dev/$b  ($(disk_desc "$b"))")"
    done
  else
    log_warn "$(zh_en '无法识别启动盘 —— 改用"有分区正在挂载的盘"来保护运行中的系统' \
                      'Could not identify the boot disk - falling back to excluding disks with mounted partitions')"
  fi

  # (1) 显式指定
  if [ -n "$FORCE_DISK" ]; then
    f=$(basename "$FORCE_DISK")
    if [ ! -b "/dev/$f" ]; then
      log_err "$(zh_en "指定的目标盘不存在: $FORCE_DISK" "Target disk does not exist: $FORCE_DISK")"
      return 1
    fi
    if is_boot_disk "$f" || { is_mounted_disk "$f" && [ "$FORCE_WIPE" != "1" ]; }; then
      log_err "$(zh_en "$FORCE_DISK 正在被系统使用(启动盘, 或承载系统本身的分区在挂载), 拒绝写入" \
                        "$FORCE_DISK is in use (boot disk, or a partition holding the running system) - refusing")"
      log_warn "$(zh_en '  要重刷这块盘: 从 U 盘启动后再执行, 或直接用 sysupgrade 升级。' \
                        '  To reflash it: boot from the USB stick first, or use sysupgrade.')"
      return 1
    fi
    if [ "$(disk_transport "$f")" = "usb" ]; then
      log_warn "$(zh_en "$FORCE_DISK 是 USB 设备 —— 你显式指定了, 按你的意思继续" \
                        "$FORCE_DISK is a USB device - you asked for it explicitly, continuing")"
    fi
    TARGET="/dev/$f"
    log_info "$(zh_en "目标盘(显式指定): $TARGET  ($(disk_desc "$f"))" "Target disk (explicit): $TARGET  ($(disk_desc "$f"))")"
    return 0
  fi

  # (2) 自动筛选
  CAND=""
  for d in $(list_disks); do
    if is_boot_disk "$d"; then
      log_warn "$(zh_en "跳过启动盘 /dev/$d" "Skipping boot disk /dev/$d")"
      continue
    fi
    if is_mounted_disk "$d"; then
      log_warn "$(zh_en "跳过正在使用的盘 /dev/$d (承载系统本身的分区在挂载: $(disk_mounts "$d"))" \
                        "Skipping disk in use /dev/$d (a partition holding the running system: $(disk_mounts "$d"))")"
      log_warn "$(zh_en '  确实要写它: 加 --force, 或先 umount 再重试' \
                        '  If you really mean it: add --force, or umount it first')"
      continue
    fi
    # 只是数据分区被自动挂载(老系统残留)不算在用: 写盘前会先卸掉
    mm=$(disk_mounts "$d" || true)
    [ -n "$mm" ] && log_info "$(zh_en "候选盘 /dev/$d 有已挂载的数据分区($mm), 写盘前会自动卸载" \
                                       "Candidate /dev/$d has mounted data partitions ($mm); will unmount before writing")"
    if [ "$(disk_transport "$d")" = "usb" ]; then
      log_warn "$(zh_en "跳过USB设备 /dev/$d" "Skipping USB device /dev/$d")"
      continue
    fi
    log_info "$(zh_en "候选盘: /dev/$d  ($(disk_desc "$d"))" "Candidate disk: /dev/$d  ($(disk_desc "$d"))")"
    CAND="$CAND $d"
  done

  N=0
  for d in $CAND; do N=$((N + 1)); done

  if [ "$N" -eq 0 ]; then
    log_err "$(zh_en '未找到可写入的硬盘!' 'No writable disk found!')"
    log_warn "$(zh_en "已排除: 启动盘(${BOOT_DISKS:-未知})、承载运行系统的盘(${MOUNTED_DISKS:-无})、所有 USB 设备。" \
                      "Excluded: boot disk (${BOOT_DISKS:-unknown}), disks holding the running system (${MOUNTED_DISKS:-none}), all USB devices.")"
    log_warn "$(zh_en '要写到外置盘/U盘请显式指定: openwrt-install --disk /dev/sdX' \
                      'To write to an external/USB disk, name it: openwrt-install --disk /dev/sdX')"
    log_warn "$(zh_en '若这台机器只有一块盘且正在运行它: 请从 U 盘启动后再装, 或用 sysupgrade 升级。' \
                      'If this machine only has the disk it is running from: boot from USB, or use sysupgrade.')"
    return 1
  fi

  if [ "$N" -eq 1 ]; then
    TARGET="/dev/$(first_cand)"
    log_info "$(zh_en "目标盘(唯一候选): $TARGET  ($(disk_desc "$(basename "$TARGET")"))" \
                      "Target disk (only candidate): $TARGET  ($(disk_desc "$(basename "$TARGET")"))")"
    return 0
  fi

  # (3) 多块候选: 只探测时取第一块, 否则必须由人确认
  log_warn "$(zh_en "检测到 $N 块可写入的磁盘:" "Found $N writable disks:")"
  i=0
  for d in $CAND; do
    i=$((i + 1))
    echo "    $i) /dev/$d  ($(disk_desc "$d"))"
  done

  if [ "$FIRST_ONLY" = "1" ]; then
    # 注意: 不能用 `for d in $CAND; do TARGET=...; done` —— 那样留下的是
    # 最后一块, 与这里的"只探测第一块"语义相反。
    TARGET="/dev/$(first_cand)"
    log_info "$(zh_en "(仅探测)使用第一块候选盘: $TARGET" "(probe only) using first candidate: $TARGET")"
    return 0
  fi

  if [ ! -t 0 ]; then
    log_err "$(zh_en '当前不是交互终端, 无法询问, 拒绝替你猜哪块盘。' \
                      'Not an interactive terminal - refusing to guess which disk to wipe.')"
    log_warn "$(zh_en '请用 --disk /dev/sdX 指定目标盘后重试。' 'Re-run with --disk /dev/sdX to name the target disk.')"
    return 1
  fi

  # 有 whiptail 就用菜单选(方向键+回车, Esc 取消)。
  # 之前这里是文本提示: 刚从 whiptail 对话框出来时, 回车可能还留在输入缓冲里,
  # 被 read 吃掉就变成"空选择 -> Invalid selection -> 安装失败"(真机踩到过)。
  if [ -n "$HAS_WT" ]; then
    # 这里的 set -- 只用于拼 whiptail 参数。do_install 已把固件路径存进变量,
    # 不再依赖调用者的 "$@", 所以清空位置参数是安全的。
    set -- --title "$(zh_en '选择目标盘' 'Select target disk')" \
           --cancel-button "$(zh_en '取消' 'Cancel')" --menu \
           "$(zh_en "检测到 $N 块可写入的盘, 方向键选择(Esc=取消):" \
                      "Found $N writable disks, pick one (Esc = cancel):")" 20 76 8
    i=0
    for d in $CAND; do
      i=$((i + 1))
      set -- "$@" "$i" "/dev/$d  ($(disk_desc "$d"))"
    done
    SEL=$(whiptail "$@" 3>&1 1>&2 2>&3) || return 1
  else
    # 纯文本场景: 空行(可能是上一次对话框残留的回车)不判死, 重问几次
    SEL=""
    tries=0
    while [ -z "$SEL" ] && [ "$tries" -lt 3 ]; do
      tries=$((tries + 1))
      printf '%s' "$(zh_en '请输入编号并回车(0=取消): ' 'Enter a number (0 = cancel): ')"
      read -r SEL || SEL=0
      case "$SEL" in
        0|q|Q) log_info "$(zh_en '已取消' 'Cancelled')"; return 1 ;;
        "") log_warn "$(zh_en '没读到输入, 请再输一次编号' 'No input read, please type the number again')"; continue ;;
        *[!0-9]*) log_warn "$(zh_en "不是编号: $SEL" "Not a number: $SEL")"; SEL=""; continue ;;
      esac
    done
    [ -n "$SEL" ] || { log_err "$(zh_en '没有选择, 放弃' 'No selection, giving up')"; return 1; }
  fi

  i=0
  for d in $CAND; do
    i=$((i + 1))
    if [ "$SEL" = "$i" ]; then
      TARGET="/dev/$d"
      log_info "$(zh_en "已选择: $TARGET  ($(disk_desc "$d"))" "Selected: $TARGET  ($(disk_desc "$d"))")"
      return 0
    fi
  done
  log_err "$(zh_en "无效的编号: $SEL" "Invalid selection: $SEL")"
  return 1
}

# 目标盘容量是否装得下(未压缩)镜像。
# 虚拟机里挂一块比镜像小的空盘时, 原先只会得到 dd 的
# "No space left on device", 完全看不出是盘太小。
bytes_to_mib() { echo $(( ($1 + 1048575) / 1048576 )); }

image_raw_size() {   # 未压缩镜像大小(字节), 非 gzip 则用文件本身大小
  magic=$(dd if="$1" bs=1 count=2 status=none 2>/dev/null | od -An -tx1 | tr -d ' \n')
  if [ "$magic" = "1f8b" ]; then
    # gzip 尾部 4 字节是 ISIZE(未压缩长度, 小端)
    sz=$(tail -c 4 "$1" 2>/dev/null | od -An -tu4 2>/dev/null | tr -d ' \n')
    [ -n "$sz" ] && { echo "$sz"; return 0; }
  fi
  wc -c < "$1" 2>/dev/null | tr -d ' '
}

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# 安装方式: 克隆当前运行的介质(唯一默认路径)
#
# 用 dd 写出来的启动介质里**只有系统本身, 没有 .img.gz 文件**(ESP 才 16 MiB
# 装不下 35 MB 的镜像; rootfs 是只读 squashfs 也放不下), 而刷机时机器通常
# 根本没有网络 —— 所以"搜镜像文件 / 联网下载"这两条路都没有意义:
# 直接把当前运行的这套系统整盘复制到目标盘就行。
#
# (iStoreOS 的 quickstart "Install X86" 也是这么做的: 源码 istoreos/quickstart
#  的 backend/cmd/backend/prompt.go 里直接 dd 自己运行的那块盘。)
#
# 只有显式给了镜像路径(--fw /path/xxx.img.gz, 或把它作为最后一个参数)时,
# 才走"写镜像文件"这条路。
#
# 拷贝长度只到"最后一个分区的末尾 + 备份 GPT", 而不是整块介质
# (32G 的 U 盘不会傻拷 32G), 目标盘只要比这个长度大就行。
clone_src_disk() {   # 输出当前运行介质的整盘名(如 sda)
  d=$(first_word $BOOT_DISKS)
  [ -n "$d" ] || d=$(find_boot_disks 2>/dev/null | awk '{print $1}')
  [ -n "$d" ] || return 1
  echo "$d"
}

first_word() { set -- $1; echo "${1:-}"; }

clone_src_bytes() {   # $1=源盘设备(如 /dev/sda) -> 需要复制的字节数
  dev=$1
  maxend=0
  for idx in 1 2 3 4 5 6 7 8; do
    # 同上: 必须 || true, 否则分区数不足 8 个时 set -e 会直接退出
    r=$(gpt_part_range "$dev" "$idx" || true)
    [ -n "$r" ] || continue
    e=${r#* }
    [ "$e" -gt "$maxend" ] 2>/dev/null && maxend=$e
  done
  if [ "$maxend" -le 0 ] 2>/dev/null; then
    # 没有 GPT(例如 MBR 布局): 退化为整盘大小
    tot=$(disk_sectors "$dev")
    [ -n "$tot" ] && [ "$tot" -gt 0 ] 2>/dev/null || return 1
    echo $(( tot * 512 ))
    return 0
  fi
  # 末尾再留 34 个扇区(备份 GPT)
  echo $(( (maxend + 34) * 512 ))
}

# 算出源盘与复制长度(设定 CLONE_SRC / CLONE_BYTES), 供下面两条路径共用
clone_resolve() {
  s=$(clone_src_disk) || {
    log_err "$(zh_en '认不出当前运行的介质(启动盘), 没法克隆' \
                      'Cannot identify the running medium (boot disk), cannot clone')"
    log_warn "$(zh_en '请改用镜像文件: openwrt-install --fw /path/to/openwrt-*.img.gz' \
                      'Use an image file instead: openwrt-install --fw /path/to/openwrt-*.img.gz')"
    return 1
  }
  if [ "$s" = "$(basename "$TARGET")" ]; then
    log_err "$(zh_en '源盘和目标盘是同一块($s), 拒绝' "Source and target are the same disk ($s) - refusing")"
    return 1
  fi
  b=$(clone_src_bytes "${CLONE_SRC_PATH_OVERRIDE:-/dev/$s}") || {
    log_err "$(zh_en '读不出源盘分区表, 无法确定复制长度' 'Cannot read the source partition table')"
    return 1
  }
  CLONE_SRC=$s
  CLONE_SRC_PATH=${CLONE_SRC_PATH_OVERRIDE:-/dev/$s}
  CLONE_BYTES=$b
  return 0
}

# 准备克隆(现在是唯一的安装路径): 算出源盘与复制长度并置位
clone_prepare() {
  clone_resolve || return 1
  CLONE=1
  log_info "$(zh_en "离线克隆: $CLONE_SRC_PATH -> $TARGET (复制 $(bytes_to_mib "$CLONE_BYTES") MiB)" \
                    "Offline clone: $CLONE_SRC_PATH -> $TARGET (copying $(bytes_to_mib "$CLONE_BYTES") MiB)")"
  return 0
}

check_target_size() {
  if [ "$CLONE" = "1" ]; then
    IMG_BYTES=$CLONE_BYTES
  else
    IMG_BYTES=$(image_raw_size "$FW")
  fi
  [ -n "$IMG_BYTES" ] && [ "$IMG_BYTES" -gt 0 ] 2>/dev/null || return 0
  T_SEC=$(disk_sectors "$TARGET")
  [ -n "$T_SEC" ] && [ "$T_SEC" -gt 0 ] 2>/dev/null || return 0
  T_BYTES=$(( T_SEC * 512 ))
  if [ "$CLONE" = "1" ]; then
    log_info "$(zh_en "克隆内容 $(bytes_to_mib "$IMG_BYTES") MiB (源盘 /dev/$CLONE_SRC)   目标盘 $(bytes_to_mib "$T_BYTES") MiB" \
                      "Clone size $(bytes_to_mib "$IMG_BYTES") MiB (from /dev/$CLONE_SRC)   target disk $(bytes_to_mib "$T_BYTES") MiB")"
  else
    log_info "$(zh_en "镜像(未压缩) $(bytes_to_mib "$IMG_BYTES") MiB   目标盘 $(bytes_to_mib "$T_BYTES") MiB" \
                      "Image (uncompressed) $(bytes_to_mib "$IMG_BYTES") MiB   target disk $(bytes_to_mib "$T_BYTES") MiB")"
  fi
  if [ "$T_BYTES" -lt "$IMG_BYTES" ]; then
    log_err "$(zh_en "目标盘太小, 装不下!" "Target disk is too small!")"
    log_warn "$(zh_en "需要至少 $(bytes_to_mib "$IMG_BYTES") MiB, 而 $TARGET 只有 $(bytes_to_mib "$T_BYTES") MiB。" \
                      "Needs at least $(bytes_to_mib "$IMG_BYTES") MiB but $TARGET has only $(bytes_to_mib "$T_BYTES") MiB.")"
    log_warn "$(zh_en '请换一块更大的盘/虚拟磁盘, 或改用更小的镜像。' \
                      'Use a bigger disk/virtual disk, or a smaller image.')"
    return 1
  fi
  return 0
}

# ---------- 3. 倒计时 ----------
countdown() {
  # 这条警告是最关键的安全提示, 英文界面下也必须看得懂
  if [ "$CLONE" = "1" ]; then
    log_warn "$(zh_en "5秒后把 $CLONE_SRC_PATH 整盘克隆到 $TARGET  ($(disk_desc "$(basename "$TARGET")"))" \
                      "Cloning $CLONE_SRC_PATH to $TARGET  ($(disk_desc "$(basename "$TARGET")")) in 5 seconds")"
  else
    log_warn "$(zh_en "5秒后将把 $FW 写入 $TARGET  ($(disk_desc "$(basename "$TARGET")"))" \
                      "Writing $FW to $TARGET  ($(disk_desc "$(basename "$TARGET")")) in 5 seconds")"
  fi
  log_warn "$(zh_en "该操作会清空 $TARGET 上的所有数据! (Ctrl+C 可取消)" \
                    "ALL DATA on $TARGET will be erased! (Ctrl+C to abort)")"
  i=5
  while [ $i -gt 0 ]; do
    echo -n "$i... "; i=$((i-1)); sleep 1
  done
  echo
}

# =============================================
# 安装后的空间说明 + 扩容指引
# =============================================
# 说明: 官方 combined-efi 镜像内嵌的 GPT 只描述镜像自身大小(约 120 MiB),
# 写入大容量硬盘后, GPT 的 LastUsableLBA 仍是镜像末尾, rootfs 分区
# 固定在 ~104 MiB, 因此需要先重写 GPT 才能占满整盘。
#
# 本脚本只做只读探测与指引, 不直接改分区表 —— 重写 GPT/扩分区/扩文件系统
# 属于有数据风险的操作, 交由你确认后手动执行。
# 探测全部基于 BusyBox 自带工具(dd/od/grep), 不依赖已不在固件中的 lsblk/blkid。

SECTOR=512
# rootfs 分区的目标尺寸(MiB)。本固件镜像内 rootfs 已是该尺寸;
# 脚本不会把 rootfs 扩满整盘, 磁盘剩余空间保持未分配。
ROOT_PART_TARGET_MIB=2048

# 从磁盘读一个小端 u64 (status=none 必须加: busybox dd 默认把统计打到 stdout)
le_u64() {
  dd if="$1" bs=1 skip="$2" count=8 status=none 2>/dev/null | od -An -tu8 | tr -d ' \n'
}

# -> "start end" (扇区), 无此分区则输出空
gpt_part_range() {
  dev="$1"; idx="$2"
  base=$(( 512 + 512 + (idx - 1) * 128 ))
  s=$(le_u64 "$dev" $(( base + 32 )))
  e=$(le_u64 "$dev" $(( base + 40 )))
  [ -n "$s" ] && [ -n "$e" ] && [ "$s" -gt 0 ] 2>/dev/null && [ "$e" -ge "$s" ] 2>/dev/null \
    && printf '%s %s' "$s" "$e"
}

disk_sectors() {
  name=$(basename "$1")
  # 真实块设备: 内核已知整盘大小
  if [ -r "/sys/class/block/$name/size" ]; then
    cat "/sys/class/block/$name/size"; return
  fi
  # 普通文件(或 sysfs 不可用): 用文件大小
  sz=$(wc -c < "$1" 2>/dev/null | tr -d ' ')
  if [ -n "$sz" ] && [ "$sz" -gt 0 ] 2>/dev/null; then
    echo $(( sz / SECTOR )); return
  fi
  # 最后兜底: GPT 头声明的磁盘大小
  alt=$(le_u64 "$1" 544)
  [ -n "$alt" ] && [ "$alt" -gt 0 ] 2>/dev/null && { echo $(( alt + 1 )); return; }
  echo ""
}

# 磁盘末尾要留 33 个扇区给备份 GPT, 故最后可用 LBA = 总扇区数 - 34
disk_lba_max() {
  total=$(disk_sectors "$1")
  [ -n "$total" ] || { echo ""; return; }
  echo $(( total - 34 ))
}

# 按魔数识别文件系统: squashfs('hsqs') / ext4(superblock 0x53ef)
fs_type_at() {
  m=$(dd if="$1" bs=1 skip="$2" count=4 status=none 2>/dev/null | od -An -tx1 | tr -d ' \n')
  case "$m" in 68737173) echo squashfs; return ;; esac
  m2=$(dd if="$1" bs=1 skip=$(( $2 + 1080 )) count=2 status=none 2>/dev/null | od -An -tx1 | tr -d ' \n')
  case "$m2" in 53ef) echo ext4; return ;; esac
  echo "unknown"
}

# 扇区 -> MiB, 四舍五入, 与 resize2fs/df 报告的数值保持一致
sectors_to_mib() { echo $(( ($1 + 1024) / 2048 )); }

# 找到实际承载系统的分区: 优先匹配 ext4/squashfs 魔数, 退化为最大分区
find_rootfs_partition() {
  dev="$1"
  BEST_IDX=""; BEST_START=""; BEST_SIZE=""; BEST_FS=""
  for idx in 1 2 3 4 5 6 7 8; do
    # 注意 || true: set -e 下 "赋值+命令替换" 若命令失败会直接退出脚本 ——
    # 分区数少于 8 个时 gpt_part_range 返回非 0, 不加这个守卫整个程序就断了。
    r=$(gpt_part_range "$dev" "$idx" || true)
    [ -n "$r" ] || continue
    s=${r% *}; e=${r#* }
    sz=$(( e - s + 1 ))
    fs=$(fs_type_at "$dev" $(( s * SECTOR )))
    case "$fs" in
      ext4|squashfs)
        if [ -z "$BEST_FS" ] || [ "$sz" -gt "$BEST_SIZE" ] 2>/dev/null; then
          BEST_IDX=$idx; BEST_START=$s; BEST_SIZE=$sz; BEST_FS=$fs
        fi ;;
      *)
        if [ -z "$BEST_FS" ] && { [ -z "$BEST_SIZE" ] || [ "$sz" -gt "$BEST_SIZE" ] 2>/dev/null; }; then
          BEST_IDX=$idx; BEST_START=$s; BEST_SIZE=$sz; BEST_FS=$fs
        fi ;;
    esac
  done
}

post_install_space_report() {
  dev="$1"
  log_info "$(zh_en '检查磁盘空间占用情况...' 'Checking disk space...')"

  if [ ! -r "$dev" ]; then
    log_warn "$(zh_en "无法读取 $dev, 跳过空间检查" "Cannot read $dev, skipping space check")"
    return 0
  fi

  find_rootfs_partition "$dev"
  if [ -z "$BEST_IDX" ]; then
    log_warn "$(zh_en '未能识别系统分区, 跳过空间检查' 'System partition not recognized, skipping space check')"
    return 0
  fi

  fsmax=$(disk_lba_max "$dev")
  log_info "$(zh_en "磁盘标识     : $(basename "$dev")  (${fsmax:-未知} 可用末扇区)" \
                    "Disk         : $(basename "$dev")  (${fsmax:-unknown} last usable sector)")"
  log_info "$(zh_en "系统分区     : ${dev}${BEST_IDX}  ($(sectors_to_mib "$BEST_SIZE") MiB, ${BEST_FS})" \
                    "System part  : ${dev}${BEST_IDX}  ($(sectors_to_mib "$BEST_SIZE") MiB, ${BEST_FS})")"

  if [ -z "$fsmax" ]; then
    log_warn "$(zh_en '读不到磁盘总容量, 无法判断空间' 'Cannot read total disk size, skipping space check')"
    return 0
  fi

  # 本固件的设计: rootfs 固定为 ROOT_PART_TARGET_MIB(镜像内已是 2 GiB),
  # 剩余空间保持未分配 —— 不扩满整盘, 也不自动建数据分区。
  target_secs=$(( ROOT_PART_TARGET_MIB * 2048 ))

  if [ "$BEST_FS" = "squashfs" ]; then
    if [ "$UI_EN" = "1" ]; then
      cat <<EOF

  NOTE: you flashed the squashfs variant - the root filesystem is read-only,
  so resizing means making the extra space an overlay, not running resize2fs.
  If you want a simply writable root, use the ext4 variant instead:
    openwrt-x86-64-generic-ext4-combined-efi.img.gz
EOF
    else
      cat <<EOF

  ⚠ 你刷入的是 squashfs 版: 根文件系统为只读, 扩容语义与 ext4 不同 ——
    扩分区后需要把新空间做成 overlay, 而不是对分区跑 resize2fs。
    如需简单可写空间, 建议改用 ext4 版镜像:
      openwrt-x86-64-generic-ext4-combined-efi.img.gz
EOF
    fi
    return 0
  fi

  missing=""
  command -v sfdisk    >/dev/null 2>&1 || missing="$missing sfdisk"
  command -v resize2fs >/dev/null 2>&1 || missing="$missing resize2fs"
  [ -n "$missing" ] && log_warn "$(zh_en "缺少工具:$missing" "Missing tools:$missing")"

  if [ "$BEST_SIZE" -lt "$target_secs" ] 2>/dev/null; then
    need=$(( target_secs - BEST_SIZE ))
    log_warn "$(zh_en "rootfs 分区小于目标值: 可扩约 $(sectors_to_mib "$need") MiB" \
                      "rootfs partition is below target: $(sectors_to_mib "$need") MiB can be added")"
    log_info "$(zh_en "            分区 $(sectors_to_mib "$BEST_SIZE") MiB -> $(sectors_to_mib "$target_secs") MiB" \
                      "            partition $(sectors_to_mib "$BEST_SIZE") MiB -> $(sectors_to_mib "$target_secs") MiB")"
    if [ "$UI_EN" = "1" ]; then
      cat <<EOF

  -- Resize steps (start ${BEST_START} MUST stay the same, or the filesystem breaks) --
        echo 'start=${BEST_START}, size=${target_secs}' | sfdisk -N ${BEST_IDX} --force ${dev}
        e2fsck -fy ${dev}${BEST_IDX}
        resize2fs ${dev}${BEST_IDX}
    If the kernel does not pick up the new size, reboot then run e2fsck/resize2fs.
    sfdisk -N fixes the GPT by itself (moves the backup table, updates the
    protective MBR, raises the last usable LBA). If it says the device is busy,
    add --no-reread and then run: partx -u ${dev}
    You can also do this on another Linux host with ${dev} replaced by the real
    device name (e.g. /dev/sdX).
  ---------------------------------------------------------------------------
EOF
    else
      cat <<EOF

  ── 扩容步骤 (起点 ${BEST_START} 必须保持不变, 否则会损坏文件系统) ──
        echo 'start=${BEST_START}, size=${target_secs}' | sfdisk -N ${BEST_IDX} --force ${dev}
        e2fsck -fy ${dev}${BEST_IDX}
        resize2fs ${dev}${BEST_IDX}
    若内核未立即反映新分区大小, 重启后再执行 e2fsck/resize2fs。
    sfdisk -N 会自动修正 GPT(移备份表到盘尾/更新保护性MBR/抬高可用末LBA);
    若提示设备忙, 追加 --no-reread 再用 partx -u ${dev} 让内核重读。
    也可以在 Linux 主机上做: 把盘接到主机(或 U 盘启动 Linux),
    把 ${dev} 换成实际盘符(如 /dev/sdX)后执行同样命令。
  ────────────────────────────────────────────────────
EOF
    fi
  else
    log_info "$(zh_en "rootfs 分区 $(sectors_to_mib "$BEST_SIZE") MiB (已达目标 ${ROOT_PART_TARGET_MIB} MiB) ✅" \
                      "rootfs partition $(sectors_to_mib "$BEST_SIZE") MiB (target ${ROOT_PART_TARGET_MIB} MiB reached) OK")"
    log_info "$(zh_en '剩余空间保持未分配, 未创建数据分区(本固件的约定)' \
                      'Remaining space is left unallocated; no data partition is created (by design)')"
  fi

  if [ -n "$missing" ]; then
    log_warn "$(zh_en "固件内缺少$missing: 上面依赖它们的步骤需先安装, 或改在 Linux 主机上执行" \
                      "Missing in firmware:$missing - install them first, or do those steps on a Linux host")"
  fi
  return 0
}

# =============================================
# 交互式菜单 (whiptail)
# =============================================
# 有 whiptail 时用图形菜单; 没有则回退为纯文本交互, 保证脚本仍可用。
# 非交互场景(脚本调用/测试)可加 --no-menu 直接执行安装流程。

# 菜单需要: (1) 装了 whiptail (2) 有可用终端。
# 只判断命令存在是不够的 —— 无终端时 whiptail 会直接失败。
HAS_WT=""
if command -v whiptail >/dev/null 2>&1; then
  if [ -t 0 ] || [ -t 1 ] || [ -t 2 ]; then
    HAS_WT=1
    TERM=${TERM:-linux}
    export TERM
  fi
fi

msg() { # $1=标题 $2=内容
  if [ -n "$HAS_WT" ]; then
    whiptail --title "$1" --msgbox "$2" 18 74
  else
    echo "===== $1 ====="
    printf '%b\n' "$2"
    echo
    printf '%s' "$(zh_en '按回车继续...' 'Press Enter to continue...')"
    read _x
  fi
}

confirm() { # $1=标题 $2=内容 -> 0=确认
  if [ -n "$HAS_WT" ]; then
    whiptail --title "$1" --yesno "$2" 16 74
  else
    echo "===== $1 ====="
    printf '%b\n' "$2"
    printf '%s' "$(zh_en '确认执行? [y/N] ' 'Continue? [y/N] ')"
    read _a
    case "$_a" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
  fi
}

input_box() { # $1=标题 $2=提示 $3=默认值 -> 结果打印到 stdout
  if [ -n "$HAS_WT" ]; then
    whiptail --title "$1" --inputbox "$2" 12 74 "$3" 3>&1 1>&2 2>&3
  else
    printf '%s [%s]: ' "$2" "$3" >&2
    read _v
    [ -n "$_v" ] || _v=$3
    printf '%s' "$_v"
  fi
}

# 校验 IPv4 点分十进制 (纯 shell, 不依赖 python3 —— 固件里没有 python3)
valid_ipv4() {
  printf '%s' "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
  # 每段必须是 0-255, 且不接受前导零(010 会被当作八进制解析)
  OIFS=$IFS; IFS=.
  for o in $1; do
    case "$o" in
      0|[1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]) : ;;
      *) IFS=$OIFS; return 1 ;;
    esac
  done
  IFS=$OIFS
  return 0
}

# 修改 LAN 口 IP (对应 iStoreOS quickstart 里的改 IP 功能)
change_lan_ip() {
  CUR=$(uci -q get network.lan.ipaddr 2>/dev/null || true)
  [ -n "$CUR" ] || CUR=10.0.0.1
  NEW=$(input_box "$(zh_en '修改 LAN 口 IP' 'Change LAN IP')" \
    "$(zh_en "请输入新的 LAN 口 IP 地址 (当前 $CUR):" "New LAN IP address (current $CUR):")" "$CUR") || return 0
  [ -n "$NEW" ] || return 0
  if ! valid_ipv4 "$NEW"; then
    msg "$(zh_en '错误' 'Error')" "$(zh_en "'$NEW' 不是合法的 IPv4 地址。" "'$NEW' is not a valid IPv4 address.")"
    return 1
  fi
  if confirm "$(zh_en '确认修改' 'Confirm change')" \
     "$(zh_en "将把 LAN 口 IP 改为 $NEW\n\n注意: 修改后当前连接会断开, 需要访问新地址、或重新获取 DHCP。\n是否继续?" \
                "LAN IP will be changed to $NEW\n\nYour current connection will drop.\nContinue?")"; then
    uci set network.lan.ipaddr="$NEW" || { msg "$(zh_en '错误' 'Error')" "$(zh_en '写入 uci 失败' 'Failed to write uci')"; return 1; }
    uci commit network
    if [ -n "$HAS_WT" ]; then
      whiptail --title "$(zh_en '已修改' 'Changed')" \
        --infobox "$(zh_en "正在应用网络配置...\n\n新地址: http://$NEW" "Applying network config...\n\nNew address: http://$NEW")" 10 60
    fi
    /etc/init.d/network reload >/dev/null 2>&1 || service network reload >/dev/null 2>&1 || true
    msg "$(zh_en '完成' 'Done')" \
      "$(zh_en "LAN 口 IP 已改为: $NEW\n\n请用浏览器访问  http://$NEW\n若当前连接已断开, 请到新网段重新连接。" \
                 "LAN IP is now: $NEW\n\nOpen http://$NEW\nReconnect from the new subnet if the link dropped.")"
  fi
}

# 修改 root 密码
change_password() {
  if confirm "$(zh_en '修改密码' 'Change password')" \
     "$(zh_en '接下来会调用 passwd, 请按提示输入两次新密码。\n\n是否继续?' 'passwd will run for root. Enter the new password twice.\n\nContinue?')"; then
    passwd root || msg "$(zh_en '提示' 'Notice')" "$(zh_en '密码修改未完成或已取消。' 'Password change was not completed.')"
  fi
}

# 列出物理以太网口(排除 lo / 虚拟接口 / 无线)
list_nics() {
  for p in /sys/class/net/*; do
    n=$(basename "$p")
    [ "$n" = "lo" ] && continue
    case "$n" in br-*|eth*.*|wlan*|wl*) continue ;; esac
    # 只要以太网(有 device 链接 且 type=1)
    [ -e "$p/device" ] || continue
    [ "$(cat "$p/type" 2>/dev/null)" = "1" ] || continue
    printf '%s\n' "$n"
  done
}

# 设置网口模式(单网卡 / 双网卡)。
# 起因: 配置里若硬编码 eth1=LAN、eth0=WAN, 单网卡机器上就会"只有 WAN 没有 LAN",
# 表现为插上网线访问不了管理页面。此功能按实际网口数量自动调整。
set_nic_mode() {
  NICS=$(list_nics | tr '\n' ' ')
  N=$(list_nics | wc -l | tr -d ' ')
  if [ "$N" -eq 0 ]; then
    msg "$(zh_en '错误' 'Error')" \
      "$(zh_en '未检测到物理以太网口。\n若使用 USB 网卡, 请确认已插好或已装驱动。' \
                 'No physical Ethernet port found.\nIf you use a USB NIC, check it is plugged in / driver loaded.')"
    return 1
  fi
  CUR=$(uci -q get network.wan.device 2>/dev/null || true)
  CURW=$(uci -q get network.lan.device 2>/dev/null || true)
  if [ -n "$CUR" ]; then
    MODE_DESC=$(zh_en "当前: 双网卡 (LAN=$CURW, WAN=$CUR)" "Now: dual NIC (LAN=$CURW, WAN=$CUR)")
  else
    MODE_DESC=$(zh_en "当前: 单网卡 (全部作 LAN)" "Now: single NIC (all as LAN)")
  fi

  if [ -n "$HAS_WT" ]; then
    CHOICE=$(whiptail --title "$(zh_en '网口模式' 'NIC mode')" --menu \
      "$(zh_en "检测到物理网口: $NICS\n$MODE_DESC\n\n请选择:" "Physical NICs: $NICS\n$MODE_DESC\n\nChoose:")" 18 76 3 \
      "single" "$(zh_en '单网卡模式: 唯一网口作为 LAN (直接可管理)' 'Single NIC: the only NIC becomes LAN (static, manageable)')" \
      "dual"   "$(zh_en '双网卡模式: 第一个为 WAN(DHCP), 其余为 LAN' 'Dual NIC: first is WAN (DHCP), rest form the LAN bridge')" \
      "auto"   "$(zh_en '自动按网口数量判断' 'Auto by NIC count')" \
      3>&1 1>&2 2>&3) || return 0
  else
    echo ""
    echo "$(zh_en "检测到物理网口: $NICS" "Physical NICs: $NICS")"
    echo "$MODE_DESC"
    echo "  1) $(zh_en '单网卡模式 (唯一网口作为 LAN)' 'Single NIC (only NIC becomes LAN)')"
    echo "  2) $(zh_en '双网卡模式 (第一个为 WAN, 其余为 LAN)' 'Dual NIC (first = WAN, rest = LAN)')"
    echo "  3) $(zh_en '自动判断' 'Auto')"
    printf '%s' "$(zh_en '请输入编号并回车 [3]: ' 'Enter number [3]: ')"
    read -r NT
    case "${NT:-3}" in
      1) CHOICE=single ;; 2) CHOICE=dual ;; *) CHOICE=auto ;;
    esac
  fi

  case "$CHOICE" in
    auto)
      if [ "$N" -eq 1 ]; then CHOICE=single; else CHOICE=dual; fi
      ;;
  esac

  FIRST=$(list_nics | head -1)
  REST=$(list_nics | tail -n +2 | tr '\n' ' ')

  if [ "$CHOICE" = "single" ]; then
    if [ "$N" -gt 1 ]; then
      confirm "$(zh_en '提示' 'Notice')" \
        "$(zh_en "检测到 $N 个网口。\n\n单网卡模式会把【全部】网口都作为 LAN (同一网桥),\n不使用 WAN 口 —— 除非上游是光猫桥接+拨号, 否则将无法上网。\n\n确定继续?" \
                   "Found $N NICs.\n\nSingle-NIC mode puts ALL of them into one LAN bridge and uses\nno WAN port - you will have no internet unless upstream does PPPoE.\n\nContinue?")" || return 0
    fi
    uci -q delete network.wan 2>/dev/null || true
    uci -q delete network.wan6 2>/dev/null || true
    uci -q delete network.lan.device 2>/dev/null || true
    uci -q delete network.@device[0] 2>/dev/null || true
    uci set network.lan.device="$FIRST"
    for d in $REST; do uci add_list network.lan.device="$d" 2>/dev/null || true; done
    # 单网卡时 LAN 会自动成为 DHCP 客户端? 不 —— 保持静态地址便于管理
    RESULT=$(zh_en "单网卡模式: $NICS 全部作为 LAN (静态 $(uci -q get network.lan.ipaddr 2>/dev/null || echo 未设置))" \
                   "Single NIC mode: $NICS all as LAN (static $(uci -q get network.lan.ipaddr 2>/dev/null || echo unset))")
  else
    # 双网卡: 首个作 WAN, 其余作 LAN 桥
    uci -q delete network.lan.device 2>/dev/null || true
    uci -q delete network.@device[0] 2>/dev/null || true
    if [ -n "$REST" ]; then
      uci set network.@device[0]=device
      uci set network.@device[0].name='br-lan'
      uci set network.@device[0].type='bridge'
      for d in $REST; do uci add_list network.@device[0].ports="$d"; done
      uci set network.lan.device='br-lan'
      uci set network.lan.type='bridge' 2>/dev/null || true
    else
      uci set network.lan.device="$FIRST"
    fi
    uci set network.wan=device 2>/dev/null || true
    uci set network.wan=interface 2>/dev/null || true
    uci set network.wan.device="$FIRST"
    uci set network.wan.proto='dhcp'
    uci -q delete network.wan6 2>/dev/null || true
    uci set network.wan6=interface
    uci set network.wan6.device="$FIRST"
    uci set network.wan6.proto='dhcpv6'
    RESULT=$(zh_en "双网卡模式: WAN=$FIRST, LAN=${REST:-无}" "Dual NIC mode: WAN=$FIRST, LAN=${REST:-none}")
  fi

  uci commit network
  /etc/init.d/network reload >/dev/null 2>&1 || service network reload >/dev/null 2>&1 || true
  msg "$(zh_en '完成' 'Done')" \
    "$RESULT\n\n$(zh_en '网络配置已重载。若管理页面失联, 请按新地址访问或检查网线插口。' \
                             'Network config reloaded. If the UI is unreachable, use the new address or check the cable.')"
}

# 显示网络接口与地址
show_interfaces() {
  TXT=$(ip -4 addr show 2>/dev/null | awk '/^[0-9]+:/{iface=$2} /inet /{print iface" "$2}' | sed 's/:$//' | head -20)
  [ -n "$TXT" ] || TXT=$(ifconfig -a 2>/dev/null | head -20)
  LAN=$(uci -q get network.lan.ipaddr 2>/dev/null || true)
  msg "$(zh_en '网络接口' 'Network interfaces')" \
    "$(zh_en "LAN 管理地址: ${LAN:-未知}" "LAN address: ${LAN:-unknown}")$(zh_en '\n(设备名 eth0/eth1 等, 取决于网卡)' '\n(names like eth0/eth1 depend on the NIC)')\n\n$TXT"
}

# 诊断: 装不上时先跑这个, 一眼看清是哪一步不满足条件
show_diag() {
  echo "===== $(zh_en '诊断信息' 'Diagnostics') ====="
  echo "TERM=${TERM:-} LANG=${LANG:-} LC_ALL=${LC_ALL:-} UI_EN=${UI_EN:-0} uid=$(id -u 2>/dev/null)"
  echo
  echo "-- $(zh_en '整盘' 'disks') --"
  for d in $(list_disks); do echo "  /dev/$d  ($(disk_desc "$d"))"; done
  echo
  echo "-- $(zh_en '启动盘解析' 'boot disk resolution') --"
  echo "  src  = $(find_boot_src 2>/dev/null || zh_en '(未识别)' '(unidentified)')"
  echo "  disk = ${BOOT_DISKS:-$(find_boot_disks 2>/dev/null || zh_en '(未识别)' '(unidentified)')}"
  echo "  $(zh_en '承载运行系统的盘(会被保护)' 'disks holding the running system (protected)'): ${MOUNTED_DISKS:-$(critical_mounted_disks)}"
  for d in $(list_disks); do
    mm=$(disk_mounts "$d" || true)
    [ -n "$mm" ] && echo "  $(zh_en '挂载情况' 'mounts') /dev/$d: $mm"
  done
  echo
  echo "-- $(zh_en '候选判定' 'candidate decision') --"
  for d in $(list_disks); do
    if is_boot_disk "$d"; then
      echo "  /dev/$d: $(zh_en '启动盘 -> 排除' 'boot disk -> excluded')"
    elif [ "$(disk_transport "$d")" = "usb" ]; then
      echo "  /dev/$d: $(zh_en 'USB -> 排除' 'USB -> excluded')"
    else
      echo "  /dev/$d: $(zh_en '可写入 -> 候选' 'writable -> candidate')"
    fi
  done
  echo
  echo "-- $(zh_en '分区' 'partitions') --"
  for p in /sys/class/block/*; do
    [ -e "$p/partition" ] || continue
    n=$(basename "$p")
    echo "  /dev/$n  $(zh_en '所属盘' 'on')=$(disk_of_part "$n")  $(disk_transport "$(disk_of_part "$n")")"
  done
  echo
  echo "-- $(zh_en '挂载点' 'mounts (/, /rom, /overlay, usb)') --"
  awk '$2=="/"||$2=="/rom"||$2=="/overlay"||$3=="vfat"||$3=="exfat"||$3=="ntfs"{print "  "$2"  "$1"  "$3}' /proc/mounts 2>/dev/null | head -10
  echo
  echo "-- $(zh_en '克隆安装的源盘' 'clone install source') --"
  cs=$(clone_src_disk 2>/dev/null || true)
  if [ -n "$cs" ]; then
    cb=$(clone_src_bytes "/dev/$cs" 2>/dev/null || true)
    echo "  $(zh_en '源盘' 'source'): /dev/$cs   $(zh_en '需要复制' 'copy') ${cb:-?} $(zh_en '字节' 'bytes')"
  else
    echo "  $(zh_en '认不出当前启动介质, 无法克隆安装' 'cannot identify the running medium, clone install unavailable')"
  fi
  echo
  echo "-- $(zh_en '工具' 'tools') --"
  for t in whiptail sfdisk resize2fs e2fsck gunzip dd mount umount partx mkfs.ext4; do
    printf '  %-11s %s\n' "$t" "$(command -v $t 2>/dev/null || echo MISSING)"
  done
  echo
  echo "-- $(zh_en '空闲空间' 'free space') --"
  df -h / /tmp 2>/dev/null | sed 's/^/  /'
}

# 纯文本菜单兜底: 没有 whiptail 或没有终端时使用。
# 仍然是"选择"而不是记命令 —— 输入编号回车即可。
# 退出方式: 0 / q / quit / exit / 空回车 / Ctrl-D(EOF)。
text_menu() {
  while :; do
    cat <<EOF

======== $(zh_en 'OpenWrt 安装助手' 'OpenWrt Installer') ========$(ui_note)
  1) $(zh_en '安装系统到内置硬盘 (克隆当前系统, 会清空目标盘!)' 'Install to internal disk (clones the running system, ERASES it!)')
  2) $(zh_en '修改 LAN 口 IP 地址' 'Change LAN IP address')
  3) $(zh_en '修改 root 密码' 'Change root password')
  4) $(zh_en '查看网络接口' 'Show network interfaces')
  5) $(zh_en '设置网口模式(单网卡/双网卡)' 'Set NIC mode (single/dual)')
  6) $(zh_en '诊断(装不上时先看这个)' 'Diagnose (run this when install fails)')
  0) $(zh_en '退出 (输入 q 也可以)' 'Quit (or type q)')
========================================
EOF
    printf '%s' "$(zh_en '请输入编号并回车: ' 'Enter a number and press Enter: ')"
    read -r N || N=0        # Ctrl-D / EOF 一律当作退出
    case "$N" in
      1)
        printf '%s' "$(zh_en '确认把固件写入内置硬盘(会清空目标盘)? [y/N] ' 'Write firmware to the internal disk (ERASES it)? [y/N] ')"
        read -r A
        case "$A" in y|Y) do_install || true ;; *) echo "$(zh_en '已取消' 'Cancelled')" ;; esac
        ;;
      2)
        printf '%s' "$(zh_en '请输入新的 LAN 口 IP: ' 'New LAN IP: ')"
        read -r NIP
        if [ -n "$NIP" ]; then
          if valid_ipv4 "$NIP"; then
            uci set network.lan.ipaddr="$NIP" && uci commit network && \
              /etc/init.d/network reload >/dev/null 2>&1 || true
            echo "$(zh_en "LAN 口 IP 已改为 $NIP (如连接断开请访问新地址)" "LAN IP changed to $NIP (reconnect at the new address if the link dropped)")"
          else
            echo "$(zh_en "不是合法的 IPv4 地址: $NIP" "Not a valid IPv4 address: $NIP")"
          fi
        fi
        ;;
      3) passwd root ;;
      4) show_interfaces ;;
      5) set_nic_mode || true ;;
      6)
        show_diag
        printf '%s' "$(zh_en '按回车继续...' 'Press Enter to continue...')"
        read -r _x || true
        ;;
      0|q|Q|quit|QUIT|exit|EXIT|"") echo "$(zh_en '已退出' 'Bye')"; return 0 ;;
      *) echo "$(zh_en "无效编号: $N" "Invalid input: $N")" ;;
    esac
  done
}

# 主菜单
main_menu() {
  while :; do
    # --cancel-button: Esc 或"取消"按钮都直接退出(菜单项被截断时也能退出来)
    CHOICE=$(whiptail --title "$(zh_en 'OpenWrt 安装助手' 'OpenWrt Installer')" \
      --cancel-button "$(zh_en '退出' 'Quit')" --menu \
      "$(zh_en '请选择要执行的操作 (Esc=退出):' 'Select an action (Esc = quit):')$(ui_note)" 20 76 7 \
      "1" "$(zh_en '安装系统到内置硬盘 (克隆当前系统, 会清空目标盘!)' 'Install to internal disk (clones the running system, ERASES it!)')" \
      "2" "$(zh_en '修改 LAN 口 IP 地址' 'Change LAN IP address')" \
      "3" "$(zh_en '修改 root 密码' 'Change root password')" \
      "4" "$(zh_en '查看网络接口' 'Show network interfaces')" \
      "5" "$(zh_en '设置网口模式(单网卡/双网卡)' 'Set NIC mode (single/dual)')" \
      "6" "$(zh_en '诊断(装不上时先看这个)' 'Diagnose (run this when install fails)')" \
      "0" "$(zh_en '退出' 'Quit')" \
      3>&1 1>&2 2>&3) || return 0
    case "$CHOICE" in
      1)
        if confirm "$(zh_en '确认安装' 'Confirm install')" \
           "$(zh_en '即将把固件写入内置硬盘, 目标盘上的所有数据都会被清空。\n\n是否继续?' \
                      'The firmware will be written to the internal disk.\nALL DATA on the target disk will be erased.\n\nContinue?')"; then
          # 关键: 安装过程既实时显示、又存一份日志, 结束后用对话框把整段日志呈现
          # 出来 —— 否则一旦出错, 那些行会被菜单重绘立刻刷掉, 用户根本看不清报的
          # 什么错(这就是"装不上但不知道原因"的来源)。
          #
          # 为什么要包一层 ( set -e; ... ):
          #   任何 if/||/&& 包装都会让 errexit 在函数内部失效(dash 与 busybox ash
          #   都是这个语义, 已实测确认), 那样 dd 写盘失败就不会中断安装, 脚本还会
          #   继续打印"安装完成"。所以这里显式在子 shell 里恢复 errexit 得到真实
          #   失败, 再在关闭 errexit 的外层把退出码写进文件, tee 同时输出到屏幕
          #   与日志文件。
          TMPF=$(mktemp 2>/dev/null || echo /tmp/.oinst.$$)
          RCF=$(mktemp 2>/dev/null || echo /tmp/.orc.$$)
          set +e
          { ( set -e; do_install ); echo $? > "$RCF"; } 2>&1 | tee "$TMPF"
          set -e
          RC=$(cat "$RCF" 2>/dev/null || echo 1)
          TXT=$(sed 's/\x1b\[[0-9;]*m//g' "$TMPF" 2>/dev/null)
          rm -f "$TMPF" "$RCF"
          if [ "$RC" = "0" ]; then
            msg "$(zh_en '安装完成' 'Install finished')" "${TXT:-$(zh_en '无输出' 'no output')}"
          else
            msg "$(zh_en '安装失败' 'Install FAILED')" \
              "$(zh_en "返回码 $RC —— 下面是完整过程(可上下翻页)\n\n" \
                         "exit code $RC - full log below (arrow keys scroll)\n\n")${TXT:-$(zh_en '无输出' 'no output')}"
          fi
        fi
        ;;
      2) change_lan_ip || true ;;
      3) change_password ;;
      4) show_interfaces ;;
      5) set_nic_mode || true ;;
      6)
        TMPF=$(mktemp 2>/dev/null || echo /tmp/.odiag.$$)
        show_diag >"$TMPF" 2>&1 || true
        TXT=$(sed 's/\x1b\[[0-9;]*m//g' "$TMPF" 2>/dev/null)
        rm -f "$TMPF"
        msg "$(zh_en '诊断信息' 'Diagnostics')" "${TXT:-$(zh_en '未获取到信息' 'no information')}"
        ;;
      0|q|Q|quit|"") return 0 ;;
    esac
  done
}

# ---------- 安装流程 ----------
do_install() {
  # 先把固件路径存进变量: find_target_disk 内部会用 set -- 拼 whiptail 参数,
  # 不能让它依赖调用者的位置参数("$@")。
  FW_PATH=$1
  CLONE=""
  find_target_disk || return 1
  # 默认且唯一的安装路径: 克隆当前运行的介质。不再搜索镜像文件、也不提供下载。
  # 只有显式给了镜像路径时才写镜像文件(留给特殊场景, 例如在 VM 里写指定的 img.gz)。
  if [ -n "$FW_PATH" ]; then
    if [ -f "$FW_PATH" ]; then
      FW=$FW_PATH
      log_info "$(zh_en "使用指定的镜像文件: $FW" "Using the given image file: $FW")"
    else
      log_err "$(zh_en "指定的镜像文件不存在: $FW_PATH" "Given image file does not exist: $FW_PATH")"
      return 1
    fi
  else
    clone_prepare || return 1
  fi
  check_target_size || return 1
  unmount_target || return 1
  countdown

  if [ "$CLONE" = "1" ]; then
    log_info "$(zh_en "正在克隆 $CLONE_SRC_PATH -> $TARGET ..." "Cloning $CLONE_SRC_PATH -> $TARGET ...")"
    # 只复制到最后一个分区末尾(含备份 GPT), 不整盘拷贝 —— 32G 的 U 盘不会傻copy 32G
    dd if="$CLONE_SRC_PATH" of="$TARGET" bs=4M count="$(( CLONE_BYTES / 4194304 + 1 ))" conv=fsync
  elif command -v gunzip >/dev/null 2>&1; then
    log_info "$(zh_en '解压并写入镜像...' 'Decompressing and writing the image...')"
    gunzip -c "$FW" | dd of="$TARGET" bs=4M conv=fsync
  else
    log_info "$(zh_en '写入镜像...' 'Writing the image...')"
    dd if="$FW" of="$TARGET" bs=4M conv=fsync
  fi
  sync

  # 只读探测 (不自动改分区表)
  post_install_space_report "$TARGET" || true

  log_info "$(zh_en '安装完成! 请拔掉U盘重启, 首次启动约需2-3分钟.' \
                    'Done! Unplug the USB stick and reboot; first boot takes 2-3 minutes.')"
  if [ "$CLONE" = "1" ]; then
    # 克隆出来的是源盘的逐字节副本, 所以两块盘的分区 UUID 是一样的 ——
    # 同时插着两块盘开机时引导可能挑到 U 盘那份, 所以这句必须强调。
    log_warn "$(zh_en '克隆安装: 目标盘与源盘的分区 UUID 相同, 重启前务必拔掉 U 盘!' \
                      'Clone install: target has the same partition UUIDs as the source - remove the USB stick before rebooting!')"
  fi

  # 这里是"重启后怎么进去"的提示, 必须按当前 uci 配置来读。
  # 原先硬编码 "10.0.0.1 (LAN口 eth1)": 一旦用菜单 7 改过网口模式,
  # 这句话就是错的, 会把人指向不存在的口。
  LAN_IP=$(uci -q get network.lan.ipaddr 2>/dev/null || true)
  [ -n "$LAN_IP" ] || LAN_IP=10.0.0.1
  LAN_DEV=$(uci -q get network.lan.device 2>/dev/null || true)
  if [ "$LAN_DEV" = "br-lan" ]; then
    PORTS=$(uci -q get network.@device[0].ports 2>/dev/null | tr '\n' ',' | sed 's/,$//' || true)
    [ -n "$PORTS" ] && LAN_DEV="br-lan($PORTS)"
  fi
  log_info "$(zh_en "管理地址: http://${LAN_IP:-<见 /etc/config/network>}   LAN 口: ${LAN_DEV:-<见 /etc/config/network>}" \
                    "Management: http://${LAN_IP:-<see /etc/config/network>}   LAN port: ${LAN_DEV:-<see /etc/config/network>}")"
  return 0
}

# ---------- 入口 ----------
usage() {
  if [ "$UI_EN" = "1" ]; then
    cat <<EOF
Usage: openwrt-install [options] [firmware.img.gz]

  (no args)        interactive menu (recommended)
  --no-menu        skip the menu, install straight to the internal disk
  --change-ip      only change the LAN IP
  --clone          kept for compatibility: cloning the running medium is now
                   the default install method, with or without this flag
  --force          allow writing to a target that still has mounted partitions
                   (it unmounts them first; the boot disk is always refused)
  --diag           print diagnostics (disks, boot disk, candidates, clone
                   source, tools) - run this when an install fails
  --disk <dev>     target disk, e.g. --disk /dev/sdb
                   (required when several disks exist and there is no terminal;
                    OPENWRT_TARGET_DISK=/dev/sdb works too)
  --fw <path>      (optional) write this image file instead of cloning, e.g.
                   --fw /root/openwrt-*.img.gz (same as the last argument)
  --en / --zh      English (pure ASCII) / Chinese menu; same as OPENWRT_UI=en|zh
                   Use --en when the terminal cannot show Chinese (local console
                   without CJK glyphs, or a GBK SSH client). TERM=linux/dumb/empty
                   selects English automatically.
  -h, --help       this help

Menu: quit with 0, Esc, or the "Quit" button; the text menu also accepts q.

Target disk rules:
  exclude the boot disk and all USB devices -> a single candidate is used as-is
  several candidates -> you pick (no terminal => error out, never guesses)
  --disk <dev>       -> used as-is (the boot disk is still refused)

Examples:
  openwrt-install
  openwrt-install --en
  openwrt-install --diag
  openwrt-install --no-menu
  openwrt-install --no-menu /mnt/sda1/openwrt-*.img.gz
  openwrt-install --no-menu --disk /dev/sdb
  openwrt-install --change-ip
EOF
    return 0
  fi
  cat <<EOF
用法: openwrt-install [选项] [固件路径]

  (无参数)        显示交互式菜单 (推荐)
  --no-menu       跳过菜单, 直接安装到内置硬盘(原一键安装行为)
  --change-ip     直接进入"修改 LAN 口 IP"功能(对应 quickstart 的改 IP)
  --clone         兼容写法: 现在"克隆安装"就是默认行为, 加不加都一样
  --force         允许写入"仍有分区在挂载"的目标盘(会先尝试卸载; 启动盘永远拒绝)
  --diag          打印诊断信息(磁盘/启动盘/候选判定/克隆源/工具), 装不上时先跑这个
  --disk <设备>   指定目标盘, 例如 --disk /dev/sdb
                  (多块盘且非交互环境下**必须**用它; 也接受
                   OPENWRT_TARGET_DISK=/dev/sdb 环境变量)
  --fw <路径>     (可选) 不克隆, 改为写指定的镜像文件, 例如 --fw /root/openwrt-*.img.gz
                  等价于把它作为最后一个参数; 平时不需要用
  --en / --zh     菜单用英文(纯 ASCII) / 中文; 等价于 OPENWRT_UI=en|zh
                  终端显示不了中文时(本机控制台没中文字形、或 SSH 客户端
                  用 GBK)用 --en; 本机控制台(TERM=linux)会自动选英文。
  -h, --help      显示本帮助

菜单退出: 选 0 / 按 Esc / 点"退出"按钮 都可以; 纯文本菜单还可输 q。

目标盘的选择规则:
  排除 启动盘 与 所有 USB 设备 -> 唯一候选直接用
  多块候选 -> 列出让你选(非交互环境报错退出, 不会替你猜)
  --disk 指定 -> 直接用(仍会拒绝当前启动盘)

示例:
  openwrt-install                                  # 菜单模式
  openwrt-install --en                             # 英文菜单(终端不支持中文时)
  openwrt-install --clone                          # 离线克隆安装(无镜像/无网络)
  openwrt-install --diag                           # 诊断, 看为什么装不上
  openwrt-install --no-menu                        # 一键安装(自动找固件/目标盘)
  openwrt-install --no-menu /mnt/sda1/xxx.img.gz   # 指定固件
  openwrt-install --no-menu --disk /dev/sdb        # 指定目标盘
  openwrt-install --change-ip                      # 只改 IP
EOF
}

main() {
  MODE=menu
  FW_ARG=""
  FORCE_DISK=${OPENWRT_TARGET_DISK:-}
  FORCE_CLONE=""
  FORCE_WIPE=""

  # 先按环境定一次语言(让解析阶段的报错也是对的), 解析完再按 --en/--zh 重定一次
  ui_setup

  # 解析选项(不做 root 检查, 保证 --help 谁都能看)
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --no-menu) MODE=install ;;
      --change-ip) MODE=changeip ;;
      --diag|--check) MODE=diag ;;
      --clone) MODE=install ;;   # 兼容旧写法: 现在默认就是克隆
      --force|-f) FORCE_WIPE=1 ;;   # 允许写"活动分区在挂载"的盘(仍先尝试卸载; 启动盘依旧拒绝)
      --en|--english) UI_FORCE=en ;;
      --zh|--chinese) UI_FORCE=zh ;;
      --disk)
        shift
        if [ -z "${1:-}" ]; then
          log_err "$(zh_en '--disk 需要一个设备路径, 例如 --disk /dev/sdb' \
                            '--disk needs a device path, e.g. --disk /dev/sdb')"
          exit 2
        fi
        FORCE_DISK=$1 ;;
      --disk=*) FORCE_DISK=${1#--disk=} ;;
      --fw|--firmware)
        shift
        if [ -z "${1:-}" ]; then
          log_err "$(zh_en '--fw 需要一个镜像路径, 例如 --fw /root/openwrt-*.img.gz' \
                            '--fw needs an image path, e.g. --fw /root/openwrt-*.img.gz')"
          exit 2
        fi
        FW_ARG=$1 ;;
      --fw=*) FW_ARG=${1#--fw=} ;;
      -*) log_err "$(zh_en "未知选项: $1" "Unknown option: $1")"; usage; exit 2 ;;
      *) FW_ARG=$1 ;;
    esac
    shift
  done

  # 界面语言 + UTF-8 locale(必须在任何 whiptail 调用之前,
  # 否则汉字宽度算错 -> 菜单乱码/退不出去, 详见 ui_setup 上方说明)
  ui_setup

  # 诊断是只读操作, 不需要 root
  if [ "$MODE" = "diag" ]; then show_diag; exit 0; fi

  # 写盘/改网络都需要 root
  if [ "$(id -u 2>/dev/null || echo 0)" != "0" ]; then
    log_err "$(zh_en '需要 root 权限运行 (当前 uid 非 0)。请用 root 登录后重试。' \
                      'Must run as root (current uid is not 0). Log in as root and retry.')"
    echo "( $(zh_en '查看用法' 'usage'): $0 --help )"
    exit 1
  fi

  case "$MODE" in
    changeip) change_lan_ip; exit 0 ;;
    install)
      if [ -n "$FW_ARG" ]; then
        do_install "$FW_ARG"
      else
        do_install
      fi
      exit $? ;;
  esac

  # 默认进菜单: 有 whiptail 用图形菜单(方向键选择), 否则用同内容的编号菜单
  if [ -n "$HAS_WT" ]; then
    main_menu
  else
    text_menu
  fi
}

main "$@"
