#!/bin/sh
# =============================================
# openwrt-install : 一键安装 OpenWrt 到内置硬盘
# 用法: openwrt-install [固件路径]
#   - 不带参数时自动查找当前启动介质上的固件(挂载点或U盘里的 *combined-efi*.img.gz)
#   - 自动识别内置 SATA/NVMe 硬盘(排除启动U盘)
#   - 写入后只读检测空间: rootfs 固定 2048 MiB 为设计目标, 剩余空间保持未分配
#     (只读探测, 不自动修改分区表; 需要扩容时会打印具体命令)
# =============================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info()  { echo -e "${GREEN}[INFO]${NC} $*"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_err()   { echo -e "${RED}[ERROR]${NC} $*"; }

# ---------- 1. 确定目标磁盘(内置 SATA/NVMe, 排除启动U盘) ----------
find_target_disk() {
  BOOT_DEV=$(mount | awk '$3 == "/" {print $1}' | sed 's/[0-9]*$//; s/\/dev\///')
  if [ -z "$BOOT_DEV" ]; then
    BOOT_DEV=$(findmnt -no SOURCE / | sed 's/[0-9]*$//; s/\/dev\///')
  fi
  log_info "当前启动设备: /dev/$BOOT_DEV"

  if [ -b /dev/sda ]; then DISKS="sda"; fi
  for d in sda sdb sdc sdd sde; do
    if [ -b /dev/$d ]; then
      TRAN="$(lsblk -dno TRAN /dev/$d 2>/dev/null)"
      # TRAN 为 sata / nvme / usb
      if [ "$TRAN" = "usb" ]; then
        log_warn "跳过U盘 /dev/$d ($TRAN)"
      elif [ "$d" != "$BOOT_DEV" ]; then
        TARGET="/dev/$d"
        log_info "发现候选硬盘: /dev/$d ($TRAN)"
      fi
    fi
  done

  if [ -b /dev/nvme0n1 ]; then
    TARGET="/dev/nvme0n1"
    log_info "发现NVMe硬盘: /dev/nvme0n1"
  fi

  if [ -z "$TARGET" ]; then
    log_err "未找到可写入的内置硬盘! 请检查硬盘或手动指定 /dev/xxx"
    exit 1
  fi
}

# ---------- 2. 确定固件路径 ----------
find_firmware() {
  if [ -n "$1" ] && [ -f "$1" ]; then
    FW="$1"
    return
  fi
  # 搜索常见挂载点中的 combined-efi 镜像
  for mnt in /mnt /media /boot /mnt/usb; do
    [ -d "$mnt" ] || continue
    FW=$(find "$mnt" -maxdepth 3 -name "*combined-efi*.img.gz" 2>/dev/null | head -1)
    [ -n "$FW" ] && break
  done
  if [ -z "$FW" ]; then
    # 尝试再次挂载U盘(排除内置盘)
    for part in /dev/sd*[0-9]; do
      [ -b "$part" ] || continue
      TRAN="$(lsblk -dno TRAN "$(echo "$part" | sed 's/[0-9]*$//')" 2>/dev/null)"
      [ "$TRAN" = "usb" ] || continue
      mkdir -p /mnt/usb
      mount "$part" /mnt/usb 2>/dev/null || continue
      FW=$(find /mnt/usb -maxdepth 3 -name "*combined-efi*.img.gz" 2>/dev/null | head -1)
      [ -n "$FW" ] && break
      umount /mnt/usb 2>/dev/null || true
    done
  fi
  if [ -z "$FW" ]; then
    log_err "未找到固件镜像 *combined-efi*.img.gz! 请把固件放到U盘并挂载后重试, 或手动指定路径"
    exit 1
  fi
}

# ---------- 3. 倒计时 ----------
countdown() {
  log_warn "5秒后将把 $FW 写入 $TARGET, 该操作会清空目标盘所有数据!"
  i=5
  while [ $i -gt 0 ]; do
    echo -n "$i... "; i=$((i-1)); sleep 1
  done
  echo
}

# =============================================
# 安装后的空间说明 + 扩容指引
# =============================================
# 说明: 官方 combined-efi 镜像内嵌的 GPT 只描述镜像自身大小(约 120 MiB),
# 写入大容量硬盘后, GPT 的 LastUsableLBA 仍是镜像末尾, rootfs 分区
# 固定在 ~104 MiB, 因此需要先重写 GPT 才能占满整盘。
#
# 本脚本只做只读探测与指引, 不直接改分区表 —— 重写 GPT/扩分区/扩文件系统
# 属于有数据风险的操作, 交由你确认后手动执行。
# 探测全部基于 BusyBox 自带工具(dd/od/grep), 不依赖已不在固件中的 lsblk/blkid。

SECTOR=512
# rootfs 分区的目标尺寸(MiB)。本固件镜像内 rootfs 已是该尺寸;
# 脚本不会把 rootfs 扩满整盘, 磁盘剩余空间保持未分配。
ROOT_PART_TARGET_MIB=2048

# 从磁盘读一个小端 u64 (status=none 必须加: busybox dd 默认把统计打到 stdout)
le_u64() {
  dd if="$1" bs=1 skip="$2" count=8 status=none 2>/dev/null | od -An -tu8 | tr -d ' \n'
}

# -> "start end" (扇区), 无此分区则输出空
gpt_part_range() {
  dev="$1"; idx="$2"
  base=$(( 512 + 512 + (idx - 1) * 128 ))
  s=$(le_u64 "$dev" $(( base + 32 )))
  e=$(le_u64 "$dev" $(( base + 40 )))
  [ -n "$s" ] && [ -n "$e" ] && [ "$s" -gt 0 ] 2>/dev/null && [ "$e" -ge "$s" ] 2>/dev/null \
    && printf '%s %s' "$s" "$e"
}

disk_sectors() {
  name=$(basename "$1")
  # 真实块设备: 内核已知整盘大小
  if [ -r "/sys/class/block/$name/size" ]; then
    cat "/sys/class/block/$name/size"; return
  fi
  # 普通文件(或 sysfs 不可用): 用文件大小
  sz=$(wc -c < "$1" 2>/dev/null | tr -d ' ')
  if [ -n "$sz" ] && [ "$sz" -gt 0 ] 2>/dev/null; then
    echo $(( sz / SECTOR )); return
  fi
  # 最后兜底: GPT 头声明的磁盘大小
  alt=$(le_u64 "$1" 544)
  [ -n "$alt" ] && [ "$alt" -gt 0 ] 2>/dev/null && { echo $(( alt + 1 )); return; }
  echo ""
}

# 磁盘末尾要留 33 个扇区给备份 GPT, 故最后可用 LBA = 总扇区数 - 34
disk_lba_max() {
  total=$(disk_sectors "$1")
  [ -n "$total" ] || { echo ""; return; }
  echo $(( total - 34 ))
}

# 按魔数识别文件系统: squashfs('hsqs') / ext4(superblock 0x53ef)
fs_type_at() {
  m=$(dd if="$1" bs=1 skip="$2" count=4 status=none 2>/dev/null | od -An -tx1 | tr -d ' \n')
  case "$m" in 68737173) echo squashfs; return ;; esac
  m2=$(dd if="$1" bs=1 skip=$(( $2 + 1080 )) count=2 status=none 2>/dev/null | od -An -tx1 | tr -d ' \n')
  case "$m2" in 53ef) echo ext4; return ;; esac
  echo "unknown"
}

# 扇区 -> MiB, 四舍五入, 与 resize2fs/df 报告的数值保持一致
sectors_to_mib() { echo $(( ($1 + 1024) / 2048 )); }

# 找到实际承载系统的分区: 优先匹配 ext4/squashfs 魔数, 退化为最大分区
find_rootfs_partition() {
  dev="$1"
  BEST_IDX=""; BEST_START=""; BEST_SIZE=""; BEST_FS=""
  for idx in 1 2 3 4 5 6 7 8; do
    r=$(gpt_part_range "$dev" "$idx")
    [ -n "$r" ] || continue
    s=${r% *}; e=${r#* }
    sz=$(( e - s + 1 ))
    fs=$(fs_type_at "$dev" $(( s * SECTOR )))
    case "$fs" in
      ext4|squashfs)
        if [ -z "$BEST_FS" ] || [ "$sz" -gt "$BEST_SIZE" ] 2>/dev/null; then
          BEST_IDX=$idx; BEST_START=$s; BEST_SIZE=$sz; BEST_FS=$fs
        fi ;;
      *)
        if [ -z "$BEST_FS" ] && { [ -z "$BEST_SIZE" ] || [ "$sz" -gt "$BEST_SIZE" ] 2>/dev/null; }; then
          BEST_IDX=$idx; BEST_START=$s; BEST_SIZE=$sz; BEST_FS=$fs
        fi ;;
    esac
  done
}

post_install_space_report() {
  dev="$1"
  log_info "检查磁盘空间占用情况..."

  if [ ! -r "$dev" ]; then
    log_warn "无法读取 $dev, 跳过空间检查"
    return 0
  fi

  find_rootfs_partition "$dev"
  if [ -z "$BEST_IDX" ]; then
    log_warn "未能识别系统分区, 跳过空间检查"
    return 0
  fi

  fsmax=$(disk_lba_max "$dev")
  log_info "磁盘标识     : $(basename "$dev")  (${fsmax:-未知} 可用末扇区)"
  log_info "系统分区     : ${dev}${BEST_IDX}  ($(sectors_to_mib "$BEST_SIZE") MiB, ${BEST_FS})"

  if [ -z "$fsmax" ]; then
    log_warn "读不到磁盘总容量, 无法判断空间"
    return 0
  fi

  # 本固件的设计: rootfs 固定为 ROOT_PART_TARGET_MIB(镜像内已是 2 GiB),
  # 剩余空间保持未分配 —— 不扩满整盘, 也不自动建数据分区。
  target_secs=$(( ROOT_PART_TARGET_MIB * 2048 ))

  if [ "$BEST_FS" = "squashfs" ]; then
    cat <<EOF

  ⚠ 你刷入的是 squashfs 版: 根文件系统为只读, 扩容语义与 ext4 不同 ——
    扩分区后需要把新空间做成 overlay, 而不是对分区跑 resize2fs。
    如需简单可写空间, 建议改用 ext4 版镜像:
      openwrt-x86-64-generic-ext4-combined-efi.img.gz
EOF
    return 0
  fi

  missing=""
  command -v sfdisk    >/dev/null 2>&1 || missing="$missing sfdisk"
  command -v resize2fs >/dev/null 2>&1 || missing="$missing resize2fs"
  [ -n "$missing" ] && log_warn "缺少工具:$missing"

  if [ "$BEST_SIZE" -lt "$target_secs" ] 2>/dev/null; then
    need=$(( target_secs - BEST_SIZE ))
    log_warn "rootfs 分区小于目标值: 可扩约 $(sectors_to_mib "$need") MiB"
    log_info "            分区 $(sectors_to_mib "$BEST_SIZE") MiB -> $(sectors_to_mib "$target_secs") MiB"
    cat <<EOF

  ── 扩容步骤 (起点 ${BEST_START} 必须保持不变, 否则会损坏文件系统) ──
        echo 'start=${BEST_START}, size=${target_secs}' | sfdisk -N ${BEST_IDX} --force ${dev}
        e2fsck -fy ${dev}${BEST_IDX}
        resize2fs ${dev}${BEST_IDX}
    若内核未立即反映新分区大小, 重启后再执行 e2fsck/resize2fs。
    sfdisk -N 会自动修正 GPT(移备份表到盘尾/更新保护性MBR/抬高可用末LBA);
    若提示设备忙, 追加 --no-reread 再用 partx -u ${dev} 让内核重读。
    也可以在 Linux 主机上做: 把盘接到主机(或 U 盘启动 Linux),
    把 ${dev} 换成实际盘符(如 /dev/sdX)后执行同样命令。
  ────────────────────────────────────────────────────
EOF
  else
    log_info "rootfs 分区 $(sectors_to_mib "$BEST_SIZE") MiB (已达目标 ${ROOT_PART_TARGET_MIB} MiB) ✅"
    log_info "剩余空间保持未分配, 未创建数据分区(本固件的约定)"
  fi

  if [ -n "$missing" ]; then
    log_warn "固件内缺少$missing: 上面依赖它们的步骤需先安装, 或改在 Linux 主机上执行"
  fi
  return 0
}

# =============================================
# 交互式菜单 (whiptail)
# =============================================
# 有 whiptail 时用图形菜单; 没有则回退为纯文本交互, 保证脚本仍可用。
# 非交互场景(脚本调用/测试)可加 --no-menu 直接执行安装流程。

# 菜单需要: (1) 装了 whiptail (2) 有可用终端。
# 只判断命令存在是不够的 —— 无终端时 whiptail 会直接失败。
HAS_WT=""
if command -v whiptail >/dev/null 2>&1; then
  if [ -t 0 ] || [ -t 1 ] || [ -t 2 ]; then
    HAS_WT=1
    TERM=${TERM:-linux}
    export TERM
  fi
fi

msg() { # $1=标题 $2=内容
  if [ -n "$HAS_WT" ]; then
    whiptail --title "$1" --msgbox "$2" 18 74
  else
    echo "===== $1 ====="; echo "$2"; echo; printf '按回车继续...'; read _x
  fi
}

confirm() { # $1=标题 $2=内容 -> 0=确认
  if [ -n "$HAS_WT" ]; then
    whiptail --title "$1" --yesno "$2" 16 74
  else
    echo "===== $1 ====="; echo "$2"; printf '确认执行? [y/N] '; read _a
    case "$_a" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
  fi
}

input_box() { # $1=标题 $2=提示 $3=默认值 -> 结果打印到 stdout
  if [ -n "$HAS_WT" ]; then
    whiptail --title "$1" --inputbox "$2" 12 74 "$3" 3>&1 1>&2 2>&3
  else
    printf '%s [%s]: ' "$2" "$3" >&2
    read _v
    [ -n "$_v" ] || _v=$3
    printf '%s' "$_v"
  fi
}

# 校验 IPv4 点分十进制 (借内核的 inet_pton 判断, 避免手写解析出漏洞)
valid_ipv4() {
  printf '%s' "$1" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || return 1
  python3 -c "import socket,sys; socket.inet_aton(sys.argv[1])" "$1" 2>/dev/null && return 0
  # 没有 python3 时用内核 inet_pton
  ipcalc.sh "$1" >/dev/null 2>&1
}

# 修改 LAN 口 IP (对应 iStoreOS quickstart 里的改 IP 功能)
change_lan_ip() {
  CUR=$(uci -q get network.lan.ipaddr 2>/dev/null)
  [ -n "$CUR" ] || CUR=10.0.0.1
  NEW=$(input_box "修改 LAN 口 IP" "请输入新的 LAN 口 IP 地址 (当前 $CUR):" "$CUR") || return 0
  [ -n "$NEW" ] || return 0
  if ! valid_ipv4 "$NEW"; then
    msg "错误" "'$NEW' 不是合法的 IPv4 地址。"
    return 1
  fi
  if confirm "确认修改" "将把 LAN 口 IP 改为 $NEW\n\n注意: 修改后当前连接会断开, 需要访问新地址、或重新获取 DHCP。\n是否继续?"; then
    uci set network.lan.ipaddr="$NEW" || { msg "错误" "写入 uci 失败"; return 1; }
    uci commit network
    if [ -n "$HAS_WT" ]; then
      whiptail --title "已修改" --infobox "正在应用网络配置...\n\n新地址: http://$NEW" 10 60
    fi
    /etc/init.d/network reload >/dev/null 2>&1 || service network reload >/dev/null 2>&1 || true
    msg "完成" "LAN 口 IP 已改为: $NEW\n\n请用浏览器访问  http://$NEW\n若当前连接已断开, 请到新网段重新连接。"
  fi
}

# 修改 root 密码
change_password() {
  if confirm "修改密码" "接下来会调用 passwd, 请按提示输入两次新密码。\n\n是否继续?"; then
    passwd root || msg "提示" "密码修改未完成或已取消。"
  fi
}

# 显示网络接口与地址
show_interfaces() {
  TXT=$(ip -4 addr show 2>/dev/null | awk '/^[0-9]+:/{iface=$2} /inet /{print iface" "$2}' | sed 's/:$//' | head -20)
  [ -n "$TXT" ] || TXT=$(ifconfig -a 2>/dev/null | head -20)
  LAN=$(uci -q get network.lan.ipaddr 2>/dev/null)
  msg "网络接口" "LAN 管理地址: ${LAN:-未知}\n(设备名 eth0/eth1 等, 取决于网卡)\n\n$TXT"
}

# 主菜单
main_menu() {
  while :; do
    CHOICE=$(whiptail --title "OpenWrt 安装助手" --menu \
      "请选择要执行的操作:" 19 74 7 \
      "1" "安装系统到内置硬盘 (会清空目标盘!)" \
      "2" "查看磁盘与空间状态" \
      "3" "修改 LAN 口 IP 地址" \
      "4" "修改 root 密码" \
      "5" "查看网络接口" \
      "6" "显示扩容命令(如需要)" \
      "0" "退出" \
      3>&1 1>&2 2>&3) || return 0
    case "$CHOICE" in
      1)
        if confirm "确认安装" "即将把固件写入内置硬盘, 目标盘上的所有数据都会被清空。\n\n是否继续?"; then
          do_install || true
        fi
        ;;
      2|6)
        if find_target_disk >/dev/null 2>&1; then
          TMPF=$(mktemp 2>/dev/null || echo /tmp/.ospace.$$)
          post_install_space_report "$TARGET" >"$TMPF" 2>&1 || true
          TXT=$(sed 's/\x1b\[[0-9;]*m//g' "$TMPF" 2>/dev/null)
          rm -f "$TMPF"
          if [ "$CHOICE" = "2" ]; then
            msg "磁盘与空间状态" "${TXT:-未获取到信息}"
          else
            msg "扩容命令" "${TXT:-当前无需扩容}"
          fi
        else
          msg "错误" "未找到可用的内置硬盘。"
        fi
        ;;
      3) change_lan_ip || true ;;
      4) change_password ;;
      5) show_interfaces ;;
      0|"") return 0 ;;
    esac
  done
}

# ---------- 安装流程 ----------
do_install() {
  find_target_disk || return 1
  find_firmware "$@" || return 1
  countdown

  log_info "解压并写入镜像..."
  if command -v gunzip >/dev/null 2>&1; then
    gunzip -c "$FW" | dd of="$TARGET" bs=4M conv=fsync
  else
    dd if="$FW" of="$TARGET" bs=4M conv=fsync
  fi
  sync

  # 只读探测 (不自动改分区表)
  post_install_space_report "$TARGET" || true

  log_info "安装完成! 请拔掉U盘重启, 首次启动约需2-3分钟."
  log_info "默认管理地址: http://10.0.0.1 (LAN口 eth1)"
  return 0
}

# ---------- 入口 ----------
usage() {
  cat <<EOF
用法: openwrt-install [选项] [固件路径]

  (无参数)        显示交互式菜单 (推荐)
  --no-menu       跳过菜单, 直接安装到内置硬盘(原一键安装行为)
  --change-ip     直接进入"修改 LAN 口 IP"功能(对应 quickstart 的改 IP)
  -h, --help      显示本帮助

示例:
  openwrt-install                                  # 菜单模式
  openwrt-install --no-menu                        # 一键安装(自动找固件/目标盘)
  openwrt-install --no-menu /mnt/sda1/xxx.img.gz   # 指定固件
  openwrt-install --change-ip                      # 只改 IP
EOF
}

main() {
  # 帮助与非法选项不需要 root, 先处理
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    -*) case "${1:-}" in
          --change-ip|--no-menu) : ;;
          *) log_err "未知选项: $1"; usage; exit 2 ;;
        esac ;;
  esac

  # 写盘/改网络都需要 root
  if [ "$(id -u 2>/dev/null || echo 0)" != "0" ]; then
    log_err "需要 root 权限运行 (当前 uid 非 0)。请用 root 登录后重试。"
    echo "(查看用法: $0 --help)"
    exit 1
  fi

  case "${1:-}" in
    --change-ip)
      shift 2>/dev/null || true
      change_lan_ip; exit 0 ;;
    --no-menu)
      shift 2>/dev/null || true
      do_install "$@"; exit $? ;;
    -*)
      log_err "未知选项: $1"; usage; exit 2 ;;
  esac

  # 默认: 有 whiptail 就进菜单, 否则退回一键安装(保持行为可预期)
  if [ -n "$HAS_WT" ]; then
    main_menu
  else
    log_warn "未检测到 whiptail, 无法显示菜单, 直接进入安装流程"
    log_warn "(如需菜单请安装: apk add whiptail)"
    do_install "$@"
  fi
}

main "$@"
