{
	"luci-app-disktool": {
		"description": "Grant access to the disk manager page (System -> Storage)",
		"read": {
			"file": {
				"/usr/bin/openwrt-storage": [ "exec" ],
				"/proc/mounts": [ "read" ],
				"/proc/self/mountinfo": [ "read" ]
			}
		},
		"write": {
			"file": {
				"/usr/bin/openwrt-storage": [ "exec" ]
			}
		}
	}
}
